		local activeW    = 0
		local wpSpam     = false
		local scriptT    = tick()
		local itemRun    = false
		local itemWorker
		local itemLocked = {}
		local tItems     = 0
		local itemFilter = {}
		local favorites  = {["ASH 12.7"]=true,["BFG-50"]=true,["M200"]=true,["Purplecard"]=true}
	
		local STOP_SELL_ITEMS = {["ASH 12.7"]=true,["BFG-50"]=true,["M200"]=true}
		local STOP_TP_ITEMS   = {["Bluecard"]=true,["Greencard"]=true,["Purplecard"]=true}
	
		-- CHEATS
		local flyOn    = false
		local noclipOn = false
		local hitboxOn = false
		local flySpd   = 50
		local hbSize   = 10
		local hbOpac   = 0
		local flyConn, noclipConn, hitboxConn
		local flyBV, flyBG
		local expanded = {}
		local hbBoxes  = {}
		local KB = {fly=Enum.KeyCode.F, noclip=Enum.KeyCode.N, hitbox=Enum.KeyCode.H}
		local binding  = nil
	
		-- RARITIES — Purple added back as id 4, rest shift
		local RARITIES = {
			{id=1, name="Grey",         color=Color3.fromRGB(180,180,180), sol="Solution1"},
			{id=2, name="Green",        color=Color3.fromRGB(80,200,80),   sol="Solution2"},
			{id=3, name="Blue",         color=Color3.fromRGB(80,160,255),  sol="Solution3"},
			{id=4, name="Purple",       color=Color3.fromRGB(180,80,255),  sol=nil},        -- no solution
			{id=5, name="Gold",         color=Color3.fromRGB(255,200,0),   sol="Solution4"},
			{id=6, name="Mythic",       color=Color3.fromRGB(180,20,20),   sol="Solution5"},
			{id=7, name="Divine",       color=Color3.fromRGB(240,240,255), sol="Solution6"},
			{id=8, name="Transcendent", color=Color3.fromRGB(0,220,255),   sol="Solution7"},
		}
	
		local rOn, shopOn, rCounts = {},{},{}
		for _, r in ipairs(RARITIES) do
			rOn[r.id]=true
			if r.sol then shopOn[r.id]=true end
			rCounts[r.id]=0
		end
	
		-- Config functions defined here so all locals (rOn, shopOn, blEnabled, flySpd, etc.) are in scope
		saveConfigData = function(name)
			if not writefile then return false,"No writefile" end
			local ok,err=pcall(function()
				local HS=game:GetService("HttpService")
				local data={S={},rOn={},shopOn={},favorites={},
					VAULT_RADIUS=VAULT_RADIUS,
					flySpd=flySpd,hbSize=hbSize,hbOpac=hbOpac,
					blEnabled=blEnabled,
				}
				for k,v in pairs(S) do data.S[k]=v end
				for k,v in pairs(rOn) do data.rOn[tostring(k)]=v end
				for k,v in pairs(shopOn) do data.shopOn[tostring(k)]=v end
				for k,v in pairs(favorites) do data.favorites[k]=v end
				writefile(name..".json",HS:JSONEncode(data))
			end)
			return ok,err
		end
	
		loadConfigData = function(name)
			if not readfile then return false,"No readfile" end
			local ok,data=pcall(function()
				local HS=game:GetService("HttpService")
				return HS:JSONDecode(readfile(name..".json"))
			end)
			if not ok or not data then return false,"File not found" end
			if data.S then for k,v in pairs(data.S) do if S[k]~=nil then S[k]=v end end end
			if data.rOn then for k,v in pairs(data.rOn) do local id=tonumber(k) if id then rOn[id]=v end end end
			if data.shopOn then for k,v in pairs(data.shopOn) do local id=tonumber(k) if id then shopOn[id]=v end end end
			if data.VAULT_RADIUS then VAULT_RADIUS=data.VAULT_RADIUS end
			if data.flySpd then flySpd=data.flySpd end
			if data.hbSize then hbSize=data.hbSize end
			if data.hbOpac then hbOpac=data.hbOpac end
			if data.blEnabled~=nil then blEnabled=data.blEnabled end
			if data.favorites then for k,v in pairs(data.favorites) do favorites[k]=v end end
			return true
		end
	
		-- Auto-load default config, or write defaults if no file exists yet
		if not loadConfigData(CONFIG_FILE) then
			saveConfigData(CONFIG_FILE)
		end
	
		crates.ChildRemoved:Connect(function(c) blacklist[c]=nil locked[c]=nil end)
		plr.CharacterAdded:Connect(function(char)
			refreshChar(char)
			if noclipOn then
				for _, p in ipairs(char:GetDescendants()) do
					if p:IsA("BasePart") then p.CanCollide=false end
				end
			end
		end)
	
		-- CRATE HELPERS
		local ROOT_NAMES={"Root","HitBox","Main","Base","Part","PrimaryPart"}
		local function findRoot(c)
			for _,name in ipairs(ROOT_NAMES) do
				local p=c:FindFirstChild(name)
				if p and p:IsA("BasePart") then return p end
			end
			if c:IsA("Model") and c.PrimaryPart then return c.PrimaryPart end
			for _,p in ipairs(c:GetDescendants()) do
				if p:IsA("BasePart") then return p end
			end
			return nil
		end
	
		-- ITEM PRIORITY
		local PRIORITY_ITEMS = {"ASH 12.7","BFG-50","M200"}
		local PRIORITY_KEYWORDS = {"Tourmaline","Keycard"}
	
		local function getItemName(collider)
			for _,child in ipairs(collider:GetChildren()) do
				if child.Name ~= "Prompt" and child.Name ~= "Weld" then
					return child.Name
				end
			end
			return collider.Name
		end
	
		local function getPriority(name)
			for i,p in ipairs(PRIORITY_ITEMS) do
				if name == p then return i end
			end
			for i,kw in ipairs(PRIORITY_KEYWORDS) do
				if name:find(kw,1,true) then return #PRIORITY_ITEMS+i end
			end
			return math.huge
		end
	
		local function crateOk(c)
			if c:GetAttribute("Open")==true then return false end
			if locked[c] then return false end
			if blEnabled and blacklist[c] then
				if tick()-blacklist[c] < S.BLACKLIST_TTL*60 then return false end
				blacklist[c]=nil
			end
			if inVault(c) then return false end
			if not findRoot(c) then return false end
			local r = c:GetAttribute("Rarity")
			if r==nil then return true end
			return rOn[math.min(r,8)]==true
		end
	
		local function sortedCrates()
			local t={}
			local allCrates={}
			for _,v in ipairs(crates:GetChildren()) do
				if v:IsA("Model") then allCrates[#allCrates+1]=v end
			end
			for _,v in ipairs(allCrates) do
				if not v:GetAttribute("PinkVault") and not v:GetAttribute("GreenVault") and crateOk(v) then
					t[#t+1]=v
				end
			end
			local myPos = hrp and hrp.Position or Vector3.zero
			table.sort(t,function(a,b)
				local ra=(a:GetAttribute("Rarity") or 1)
				local rb=(b:GetAttribute("Rarity") or 1)
				if ra~=rb then return ra>rb end
				local ra_=findRoot(a) local rb_=findRoot(b)
				local da=ra_ and (ra_.Position-myPos).Magnitude or math.huge
				local db=rb_ and (rb_.Position-myPos).Magnitude or math.huge
				return da<db
			end)
			return t
		end
	
		local function rattempts(rid) return S.OPEN_ATTEMPTS_BASE+math.max(0,rid-2) end
		local function rcollect(rid)
			if rid<=2 then return 2 elseif rid<=4 then return 3 elseif rid<=6 then return 4 else return 5 end
		end
	
		local function spamE(n)
			for i=1,n do
				VIM:SendKeyEvent(true,Enum.KeyCode.E,false,game)
				task.wait(S.E_PRESS_WAIT)
				VIM:SendKeyEvent(false,Enum.KeyCode.E,false,game)
				task.wait(S.E_PRESS_WAIT)
			end
		end
	
		local function spamEAsync(dur)
			task.spawn(function()
				local e=tick()+dur
				while tick()<e do
					VIM:SendKeyEvent(true,Enum.KeyCode.E,false,game)
					task.wait(0.03)
					VIM:SendKeyEvent(false,Enum.KeyCode.E,false,game)
					task.wait(0.03)
				end
			end)
		end
	
		local function getFCF(root)
			return CFrame.new(
				root.CFrame.Position + root.CFrame.LookVector*S.STAND_OFFSET,
				root.CFrame.Position)
		end
	
		local function wpSpamFn(cb)
			if not WP then if cb then cb() end return end
			wpSpam=true
			task.spawn(function()
				local t=tick()
				while wpSpam and tick()-t < S.WAYPOINT_REST do
					if hrp then hrp.CFrame=CFrame.new(WP) end
					task.wait(S.WAYPOINT_TP_INTERVAL)
				end
				wpSpam=false
				if cb then cb() end
			end)
		end
	
		-- FLY
		local function enableFly()
			if not hrp then return end
			flyOn=true
			flyBG=Instance.new("BodyGyro")
			flyBG.MaxTorque=Vector3.new(1e9,1e9,1e9) flyBG.P=1e5 flyBG.Parent=hrp
			flyBV=Instance.new("BodyVelocity")
			flyBV.MaxForce=Vector3.new(1e9,1e9,1e9) flyBV.Velocity=Vector3.zero flyBV.Parent=hrp
			if humanoid then humanoid.PlatformStand=true end
			flyConn=RunService.RenderStepped:Connect(function()
				if not flyOn or not hrp then return end
				local cf=cam.CFrame local v=Vector3.zero
				if UIS:IsKeyDown(Enum.KeyCode.W) then v+=cf.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.S) then v-=cf.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.A) then v-=cf.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.D) then v+=cf.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.Space) then v+=Vector3.new(0,1,0) end
				if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then v-=Vector3.new(0,1,0) end
				if v.Magnitude>0 then v=v.Unit*flySpd end
				flyBV.Velocity=v flyBG.CFrame=cf
			end)
		end
	
		local function disableFly()
			flyOn=false
			if flyConn then flyConn:Disconnect() flyConn=nil end
			if flyBV then flyBV:Destroy() flyBV=nil end
			if flyBG then flyBG:Destroy() flyBG=nil end
			if humanoid then humanoid.PlatformStand=false end
		end
	
		-- NOCLIP
		local function enableNoclip()
			noclipOn=true
			noclipConn=RunService.Stepped:Connect(function()
				if not noclipOn or not plr.Character then return end
				for _, p in ipairs(plr.Character:GetDescendants()) do
					if p:IsA("BasePart") then p.CanCollide=false end
				end
			end)
		end
	
		local function disableNoclip()
			noclipOn=false
			if noclipConn then noclipConn:Disconnect() noclipConn=nil end
			if plr.Character then
				for _, p in ipairs(plr.Character:GetDescendants()) do
					if p:IsA("BasePart") then p.CanCollide=true end
				end
			end
		end
	
		-- HITBOX
		local function destroyBox(p)
			if hbBoxes[p] then hbBoxes[p]:Destroy() hbBoxes[p]=nil end
		end
	
		local function createBox(p)
			if not p.Character then return end
			local ph=p.Character:FindFirstChild("HumanoidRootPart")
			if not ph then return end
			destroyBox(p)
			if hbOpac==0 then return end
			local s=Instance.new("SelectionBox")
			s.Adornee=ph s.Color3=Color3.fromRGB(255,50,50)
			s.LineThickness=0.05 s.SurfaceColor3=Color3.fromRGB(255,0,0)
			s.SurfaceTransparency=1-(hbOpac/100)
			s.Parent=cam hbBoxes[p]=s
		end
	
		local function refreshAllBoxes()
			for _, p in ipairs(Players:GetPlayers()) do
				if p~=plr then destroyBox(p) if hbOpac>0 then createBox(p) end end
			end
		end
	
		local function applyHB()
			for _, p in ipairs(Players:GetPlayers()) do
				if p~=plr and p.Character then
					local ph=p.Character:FindFirstChild("HumanoidRootPart")
					if ph then
						if not expanded[p] then expanded[p]=ph.Size end
						ph.Size=Vector3.new(hbSize,hbSize,hbSize)
						if not hbBoxes[p] and hbOpac>0 then createBox(p)
						elseif hbBoxes[p] then
							hbBoxes[p].Adornee=ph
							hbBoxes[p].SurfaceTransparency=1-(hbOpac/100)
						end
					end
				end
			end
		end
	
		local function restoreHB()
			for p,s in pairs(expanded) do
				if p.Character then
					local ph=p.Character:FindFirstChild("HumanoidRootPart")
					if ph then ph.Size=s end
				end
				destroyBox(p)
			end
			expanded={}
		end
	
		local function enableHB()
			hitboxOn=true applyHB()
			hitboxConn=RunService.Heartbeat:Connect(function() if hitboxOn then applyHB() end end)
		end
	
		local function disableHB()
			hitboxOn=false
			if hitboxConn then hitboxConn:Disconnect() hitboxConn=nil end
			restoreHB()
		end
	
