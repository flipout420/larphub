					if name=="" then setCfgStatus("Enter a name first",C.red) return end
					local ok,err=loadConfig(name)
					if ok then
						setCfgStatus("Loaded: "..name,C.green)
						skipBtn.Text=blEnabled and "ON" or "OFF"
						skipBtn.BackgroundColor3=blEnabled and C.green or C.red
					else setCfgStatus("Load failed: "..(err or ""),C.red) end
				end)
				delBtn.MouseButton1Click:Connect(function()
					local name=cfgNameBox.Text
					if name=="" then setCfgStatus("Enter a name first",C.red) return end
					if deletefile then
						local ok=pcall(function() deletefile(name..".json") end)
						if ok then setCfgStatus("Deleted: "..name,C.orange) refreshCfgList()
						else setCfgStatus("Delete failed",C.red) end
					else setCfgStatus("No deletefile support",C.red) end
				end)
			end
