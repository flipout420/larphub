			l.Font = fnt or FR; l.TextXAlignment = xa or Enum.TextXAlignment.Left
			l.Size = UDim2.new(1, 0, 0, (sz or 12) + 4); l.TextWrapped = true
			if lo then l.LayoutOrder = lo end; return l
		end
	
