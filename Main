		local function mkInput(p, ltext, hint, val, onChange, lo)
			local card = Instance.new("Frame", p)
			card.Size = UDim2.new(1, 0, 0, 64); card.BackgroundColor3 = C.card
			card.BorderSizePixel = 0; card.LayoutOrder = lo or 0
			mkCorner(card, 8); mkStroke(card, C.border)
			local lbl = Instance.new("TextLabel", card)
			lbl.Size = UDim2.new(1, -20, 0, 13); lbl.Position = UDim2.new(0, 10, 0, 8)
			lbl.BackgroundTransparency = 1; lbl.Text = ltext; lbl.TextSize = 10
			lbl.TextColor3 = C.sub; lbl.Font = FS; lbl.TextXAlignment = Enum.TextXAlignment.Left
			local box = Instance.new("TextBox", card)
			box.Size = UDim2.new(1, -20, 0, 28); box.Position = UDim2.new(0, 10, 0, 26)
			box.BackgroundColor3 = C.bg; box.BorderSizePixel = 0
			box.PlaceholderText = hint or ""; box.PlaceholderColor3 = C.muted
			box.Text = tostring(val or ""); box.TextSize = 12; box.TextColor3 = C.txt
			box.Font = FR; box.TextXAlignment = Enum.TextXAlignment.Left; box.ClearTextOnFocus = false
			mkCorner(box, 6); mkStroke(box, C.border); mkPad(box, nil, 8, 0)
			box.Focused:Connect(function()    tw(box, { BackgroundColor3 = C.panel }) end)
			box.FocusLost:Connect(function()
				tw(box, { BackgroundColor3 = C.bg })
				if onChange then onChange(box.Text) end
				saveConfig(cfg)
			end)
			return card, box
		end
	
		local function mkToggle(p, ltext, desc, val, onChange, lo)
			local h = desc and 56 or 42
			local card = Instance.new("Frame", p)
			card.Size = UDim2.new(1, 0, 0, h); card.BackgroundColor3 = C.card
			card.BorderSizePixel = 0; card.LayoutOrder = lo or 0
			mkCorner(card, 8); mkStroke(card, C.border)
			local lbl = Instance.new("TextLabel", card)
			lbl.Size = UDim2.new(1, -60, 0, 16); lbl.Position = UDim2.new(0, 12, 0, desc and 10 or 13)
			lbl.BackgroundTransparency = 1; lbl.Text = ltext; lbl.TextSize = 12
			lbl.TextColor3 = C.txt; lbl.Font = FS; lbl.TextXAlignment = Enum.TextXAlignment.Left
			if desc then
				local d = Instance.new("TextLabel", card)
				d.Size = UDim2.new(1, -60, 0, 12); d.Position = UDim2.new(0, 12, 0, 28)
				d.BackgroundTransparency = 1; d.Text = desc; d.TextSize = 10
				d.TextColor3 = C.muted; d.Font = FR; d.TextXAlignment = Enum.TextXAlignment.Left
			end
			local track = Instance.new("Frame", card)
			track.Size = UDim2.new(0, 38, 0, 20); track.Position = UDim2.new(1, -50, 0.5, -10)
			track.BackgroundColor3 = val and C.accent or C.border; track.BorderSizePixel = 0
			mkCorner(track, 10)
			local knob = Instance.new("Frame", track)
			knob.Size = UDim2.new(0, 14, 0, 14)
			knob.Position = val and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
			knob.BackgroundColor3 = C.white; knob.BorderSizePixel = 0; mkCorner(knob, 7)
			local state = val
			local btn = Instance.new("TextButton", card)
			btn.Size = UDim2.new(1, 0, 1, 0); btn.BackgroundTransparency = 1
			btn.Text = ""; btn.BorderSizePixel = 0
			btn.MouseButton1Click:Connect(function()
				state = not state
				tw(track, { BackgroundColor3 = state and C.accent or C.border })
				tw(knob,  { Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7) })
				if onChange then onChange(state) end
				saveConfig(cfg)
			end)
			return card
		end
	
		local function mkSlider(p, ltext, mn, mx, val, step, onChange, lo, fmtVal)
			step = step or 1
			local function quantize(x)
				return math.floor(x / step + 0.5) * step
			end
			local card = Instance.new("Frame", p)
			card.Size = UDim2.new(1, 0, 0, 64); card.BackgroundColor3 = C.card
			card.BorderSizePixel = 0; card.LayoutOrder = lo or 0
			mkCorner(card, 8); mkStroke(card, C.border)
			local header = Instance.new("Frame", card)
			header.Size = UDim2.new(1, -20, 0, 18); header.Position = UDim2.new(0, 10, 0, 10)
			header.BackgroundTransparency = 1
			local lbl = Instance.new("TextLabel", header)
			lbl.Size = UDim2.new(0.7, 0, 1, 0); lbl.BackgroundTransparency = 1
			lbl.Text = ltext; lbl.TextSize = 12; lbl.TextColor3 = C.txt; lbl.Font = FS
			lbl.TextXAlignment = Enum.TextXAlignment.Left
			local valLbl = Instance.new("TextLabel", header)
			valLbl.Size = UDim2.new(0.3, 0, 1, 0); valLbl.BackgroundTransparency = 1
			valLbl.Text = fmtVal and fmtVal(val) or tostring(val)
			valLbl.TextSize = 12; valLbl.TextColor3 = C.accent
			valLbl.Font = FB; valLbl.TextXAlignment = Enum.TextXAlignment.Right
			local rangeLbl = Instance.new("TextLabel", card)
			rangeLbl.Size = UDim2.new(1, -20, 0, 10); rangeLbl.Position = UDim2.new(0, 10, 0, 28)
			rangeLbl.BackgroundTransparency = 1; rangeLbl.Text = tostring(mn) .. " – " .. tostring(mx)
			rangeLbl.TextSize = 9; rangeLbl.TextColor3 = C.muted; rangeLbl.Font = FR
			rangeLbl.TextXAlignment = Enum.TextXAlignment.Center
			local trackBg = Instance.new("Frame", card)
			trackBg.Size = UDim2.new(1, -20, 0, 5); trackBg.Position = UDim2.new(0, 10, 0, 44)
			trackBg.BackgroundColor3 = C.border; trackBg.BorderSizePixel = 0; mkCorner(trackBg, 3)
			local span = (mx - mn)
			local pct  = span > 1e-9 and (val - mn) / span or 0.5
			local fill = Instance.new("Frame", trackBg)
			fill.Size = UDim2.new(pct, 0, 1, 0); fill.BackgroundColor3 = C.accent
			fill.BorderSizePixel = 0; mkCorner(fill, 3)
			local knob = Instance.new("TextButton", trackBg)
			knob.Size = UDim2.new(0, 14, 0, 14); knob.Position = UDim2.new(pct, -7, 0.5, -7)
			knob.BackgroundColor3 = C.white; knob.Text = ""; knob.BorderSizePixel = 0; mkCorner(knob, 7)
			local dsld = false
			knob.MouseButton1Down:Connect(function() dsld = true end)
			UserInputService.InputEnded:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 then dsld = false end
			end)
			UserInputService.InputChanged:Connect(function(i)
				if dsld and i.UserInputType == Enum.UserInputType.MouseMovement then
					local rx  = i.Position.X - trackBg.AbsolutePosition.X
					local cl  = math.clamp(rx / math.max(trackBg.AbsoluteSize.X, 1), 0, 1)
					local nv  = math.clamp(quantize(mn + cl * span), mn, mx)
					local np  = span > 1e-9 and (nv - mn) / span or 0.5
					fill.Size = UDim2.new(np, 0, 1, 0); knob.Position = UDim2.new(np, -7, 0.5, -7)
					valLbl.Text = fmtVal and fmtVal(nv) or tostring(nv)
					if onChange then onChange(nv) end
					saveConfig(cfg)
				end
			end)
			return card
		end
	
		-- Dropdown: options = { "A","B" } or { { display="Label", value="A" }, ... }
		-- Dropdown overlays parented to win with ZIndex 200, escaping scroll clip via content boundary.
		local _allDropFrames = {}  -- track all open overlays for mutual-close
	
		local function mkDropdown(p, ltext, options, currentVal, onChange, lo)
			local function optPair(o)
				if type(o) == "table" and o.display and o.value then
					return o.display, o.value
				end
				return tostring(o), o
			end
			local function labelForValue(val)
				for _, o in ipairs(options) do
					local disp, v = optPair(o)
					if v == val then return disp end
				end
				return tostring(val)
			end
	
			local card = Instance.new("Frame", p)
			card.Size = UDim2.new(1, 0, 0, 64); card.BackgroundColor3 = C.card
			card.BorderSizePixel = 0; card.LayoutOrder = lo or 0
			mkCorner(card, 8); mkStroke(card, C.border)
	
			local lbl = Instance.new("TextLabel", card)
			lbl.Size = UDim2.new(1, -20, 0, 14); lbl.Position = UDim2.new(0, 10, 0, 6)
			lbl.BackgroundTransparency = 1; lbl.Text = ltext; lbl.TextSize = 10
			lbl.TextColor3 = C.sub; lbl.Font = FS; lbl.TextXAlignment = Enum.TextXAlignment.Left
	
			local selBtn = Instance.new("TextButton", card)
			selBtn.Size = UDim2.new(1, -20, 0, 28); selBtn.Position = UDim2.new(0, 10, 0, 26)
			selBtn.BackgroundColor3 = C.bg; selBtn.BorderSizePixel = 0
			selBtn.Text = "  " .. labelForValue(currentVal or (select(2, optPair(options[1]))))
			selBtn.TextSize = 11; selBtn.TextTruncate = Enum.TextTruncate.AtEnd
			selBtn.TextColor3 = C.txt; selBtn.Font = FS
			selBtn.TextXAlignment = Enum.TextXAlignment.Left
			mkCorner(selBtn, 6); mkStroke(selBtn, C.border)
	
			local chev = Instance.new("TextLabel", selBtn)
			chev.Size = UDim2.new(0, 20, 1, 0); chev.Position = UDim2.new(1, -24, 0, 0)
			chev.BackgroundTransparency = 1; chev.Text = "▾"; chev.TextSize = 12
			chev.TextColor3 = C.sub; chev.Font = FB; chev.TextXAlignment = Enum.TextXAlignment.Center
	
			-- Overlay dropdown parented to win so ZIndex stacks correctly above all content.
			-- win.ClipsDescendants is disabled (see below) so dropdowns render outside scroll area.
			local dropH = #options * 28
			local dropFrame = Instance.new("Frame", win)
			dropFrame.BackgroundColor3 = C.panel; dropFrame.BorderSizePixel = 0
			dropFrame.ZIndex = 200; dropFrame.Visible = false; dropFrame.Active = false
			mkCorner(dropFrame, 6); mkStroke(dropFrame, C.border)
			mkList(dropFrame, Enum.FillDirection.Vertical, 0)
			table.insert(_allDropFrames, dropFrame)
	
			local function positionDrop()
				local winPos = win.AbsolutePosition
				local abs    = selBtn.AbsolutePosition
				local sz     = selBtn.AbsoluteSize
				dropFrame.Position = UDim2.new(0, abs.X - winPos.X, 0, abs.Y - winPos.Y + sz.Y + 4)
				dropFrame.Size     = UDim2.new(0, sz.X, 0, dropH)
			end
	
			for _, opt in ipairs(options) do
				local disp, val = optPair(opt)
				local ob = Instance.new("TextButton", dropFrame)
				ob.Size = UDim2.new(1, 0, 0, 28); ob.BackgroundColor3 = C.panel
				ob.Text = "  " .. disp; ob.TextSize = 11; ob.TextTruncate = Enum.TextTruncate.AtEnd
				ob.TextColor3 = C.txt
				ob.Font = FS; ob.TextXAlignment = Enum.TextXAlignment.Left; ob.BorderSizePixel = 0
				ob.ZIndex = 201
				ob.MouseEnter:Connect(function() tw(ob, { BackgroundColor3 = C.card }) end)
				ob.MouseLeave:Connect(function() tw(ob, { BackgroundColor3 = C.panel }) end)
				ob.MouseButton1Click:Connect(function()
					selBtn.Text = "  " .. disp
					dropFrame.Visible = false
					dropFrame.Active  = false
					if onChange then onChange(val) end
					saveConfig(cfg)
				end)
			end
	
			selBtn.MouseButton1Click:Connect(function()
				local opening = not dropFrame.Visible
				-- close all other dropdowns first
				for _, df in ipairs(_allDropFrames) do df.Visible = false; df.Active = false end
				if opening then
					positionDrop()
					dropFrame.Visible = true
					dropFrame.Active  = true
				end
			end)
	
			UserInputService.InputBegan:Connect(function(input, gp)
				if gp then return end
				if input.UserInputType == Enum.UserInputType.MouseButton1 and dropFrame.Visible then
					local mp = input.Position
					local f  = dropFrame.AbsolutePosition
					local s  = dropFrame.AbsoluteSize
					local f2 = selBtn.AbsolutePosition
					local s2 = selBtn.AbsoluteSize
					local inDrop = mp.X >= f.X  and mp.X <= f.X  + s.X  and mp.Y >= f.Y  and mp.Y <= f.Y  + s.Y
					local inSel  = mp.X >= f2.X and mp.X <= f2.X + s2.X and mp.Y >= f2.Y and mp.Y <= f2.Y + s2.Y
					if not inDrop and not inSel then dropFrame.Visible = false; dropFrame.Active = false end
				end
			end)
	
			return card
		end
	
		local function mkThreshRow(p, itemName, currentVal, onChange, lo)
			local row = Instance.new("Frame", p)
			row.Size = UDim2.new(1, 0, 0, 40); row.BackgroundColor3 = C.card
			row.BorderSizePixel = 0; row.LayoutOrder = lo or 0
			mkCorner(row, 8); mkStroke(row, C.border)
			local dot = Instance.new("Frame", row)
			dot.Size = UDim2.new(0, 6, 0, 6); dot.Position = UDim2.new(0, 10, 0.5, -3)
			dot.BackgroundColor3 = C.accent; dot.BorderSizePixel = 0; mkCorner(dot, 3)
			local lbl = Instance.new("TextLabel", row)
			lbl.Size = UDim2.new(0.5, -10, 1, 0); lbl.Position = UDim2.new(0, 24, 0, 0)
			lbl.BackgroundTransparency = 1; lbl.Text = itemName; lbl.TextSize = 12
			lbl.TextColor3 = C.txt; lbl.Font = FS
			lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.TextYAlignment = Enum.TextYAlignment.Center
			-- delete btn
			local delBtn = Instance.new("TextButton", row)
			delBtn.Size = UDim2.new(0, 26, 0, 26); delBtn.Position = UDim2.new(1, -120, 0.5, -13)
			delBtn.BackgroundColor3 = Color3.fromRGB(30,10,10); delBtn.Text = "✕"
			delBtn.TextSize = 12; delBtn.TextColor3 = C.danger; delBtn.Font = FB
			delBtn.BorderSizePixel = 0; mkCorner(delBtn, 6)
			local minusBtn = Instance.new("TextButton", row)
			minusBtn.Size = UDim2.new(0, 26, 0, 26); minusBtn.Position = UDim2.new(1, -90, 0.5, -13)
			minusBtn.BackgroundColor3 = C.bg; minusBtn.Text = "−"; minusBtn.TextSize = 18
			minusBtn.TextColor3 = C.sub; minusBtn.Font = FB; minusBtn.BorderSizePixel = 0; mkCorner(minusBtn, 6)
			local valLbl = Instance.new("TextLabel", row)
			valLbl.Size = UDim2.new(0, 30, 0, 26); valLbl.Position = UDim2.new(1, -62, 0.5, -13)
			valLbl.BackgroundColor3 = C.bg; valLbl.Text = tostring(currentVal or 1)
			valLbl.TextSize = 13; valLbl.TextColor3 = C.accent; valLbl.Font = FB
			valLbl.TextXAlignment = Enum.TextXAlignment.Center; valLbl.BorderSizePixel = 0
			mkCorner(valLbl, 6); mkStroke(valLbl, C.border)
			local plusBtn = Instance.new("TextButton", row)
			plusBtn.Size = UDim2.new(0, 26, 0, 26); plusBtn.Position = UDim2.new(1, -30, 0.5, -13)
			plusBtn.BackgroundColor3 = C.bg; plusBtn.Text = "+"; plusBtn.TextSize = 18
			plusBtn.TextColor3 = C.sub; plusBtn.Font = FB; plusBtn.BorderSizePixel = 0; mkCorner(plusBtn, 6)
			local count = currentVal or 1
			delBtn.MouseButton1Click:Connect(function()
				cfg.thresholds[itemName] = nil; saveConfig(cfg); row:Destroy()
			end)
			minusBtn.MouseButton1Click:Connect(function()
				count = math.max(1, count-1); valLbl.Text = tostring(count)
				if onChange then onChange(count) end; saveConfig(cfg)
			end)
			plusBtn.MouseButton1Click:Connect(function()
				count = count+1; valLbl.Text = tostring(count)
				if onChange then onChange(count) end; saveConfig(cfg)
			end)
			return row
		end
	
		-- ============================================================
		--  PAGE 1 — SCAN
		-- ============================================================
		local page1, p1 = makePage()
	
		secHeader(p1, "STATUS", 1)
	
		local statCard = Instance.new("Frame", p1)
		statCard.Size = UDim2.new(1, 0, 0, 64); statCard.BackgroundColor3 = C.card
		statCard.BorderSizePixel = 0; statCard.LayoutOrder = 2
		mkCorner(statCard, 8); mkStroke(statCard, C.border)
	
		local statDot = Instance.new("Frame", statCard)
		statDot.Size = UDim2.new(0, 8, 0, 8); statDot.Position = UDim2.new(0, 14, 0, 14)
		statDot.BackgroundColor3 = C.muted; statDot.BorderSizePixel = 0; mkCorner(statDot, 4)
	
		local statTxt = Instance.new("TextLabel", statCard)
		statTxt.Size = UDim2.new(1, -36, 0, 16); statTxt.Position = UDim2.new(0, 30, 0, 10)
		statTxt.BackgroundTransparency = 1; statTxt.Text = "Idle — press START SCAN"
		statTxt.TextSize = 12; statTxt.TextColor3 = C.txt; statTxt.Font = FS
		statTxt.TextXAlignment = Enum.TextXAlignment.Left
	
		local statSub = Instance.new("TextLabel", statCard)
		statSub.Size = UDim2.new(1, -36, 0, 12); statSub.Position = UDim2.new(0, 30, 0, 30)
		statSub.BackgroundTransparency = 1; statSub.Text = "No scans this session"
		statSub.TextSize = 10; statSub.TextColor3 = C.muted; statSub.Font = FR
		statSub.TextXAlignment = Enum.TextXAlignment.Left
	
		local progBg = Instance.new("Frame", statCard)
		progBg.Size = UDim2.new(1, -20, 0, 4); progBg.Position = UDim2.new(0, 10, 1, -10)
		progBg.BackgroundColor3 = C.border; progBg.BorderSizePixel = 0; mkCorner(progBg, 2)
		local progFill = Instance.new("Frame", progBg)
		progFill.Size = UDim2.new(0, 0, 1, 0); progFill.BackgroundColor3 = C.accent
		progFill.BorderSizePixel = 0; mkCorner(progFill, 2)
	
		local function setStatus(txt, sub, col)
			statTxt.Text = txt; statSub.Text = sub or ""
			tw(statDot, { BackgroundColor3 = col or C.muted })
		end
		local function setProgress(pct)
			TweenService:Create(progFill, FI, { Size = UDim2.new(math.clamp(pct,0,1), 0, 1, 0) }):Play()
		end
	
		secHeader(p1, "VAULT TARGETS", 3)
		for i, vault in ipairs(VAULTS) do
			local row = Instance.new("Frame", p1)
			row.Size = UDim2.new(1, 0, 0, 46); row.BackgroundColor3 = C.card
			row.BorderSizePixel = 0; row.LayoutOrder = 3+i
			mkCorner(row, 8); mkStroke(row, C.border)
			local ico = Instance.new("TextLabel", row)
			ico.Size = UDim2.new(0, 38, 1, 0); ico.BackgroundTransparency = 1
			ico.Text = "🏦"; ico.TextSize = 18; ico.Font = FB
			ico.TextYAlignment = Enum.TextYAlignment.Center; ico.TextXAlignment = Enum.TextXAlignment.Center
			local vn = Instance.new("TextLabel", row)
			vn.Size = UDim2.new(1,-46,0,16); vn.Position = UDim2.new(0,40,0,8)
			vn.BackgroundTransparency = 1; vn.Text = vault.name; vn.TextSize = 12
			vn.TextColor3 = C.txt; vn.Font = FS; vn.TextXAlignment = Enum.TextXAlignment.Left
			local vp = Instance.new("TextLabel", row)
			vp.Size = UDim2.new(1,-46,0,12); vp.Position = UDim2.new(0,40,0,26)
			vp.BackgroundTransparency = 1
			vp.Text = string.format("X%.0f  Y%.0f  Z%.0f", vault.pos.X, vault.pos.Y, vault.pos.Z)
			vp.TextSize = 10; vp.TextColor3 = C.muted; vp.Font = FR
			vp.TextXAlignment = Enum.TextXAlignment.Left
		end
	
		secHeader(p1, "SCAN LOG", 8)
		local logScroll = Instance.new("ScrollingFrame", p1)
		logScroll.Size = UDim2.new(1, 0, 0, 130); logScroll.BackgroundColor3 = C.card
		logScroll.BorderSizePixel = 0; logScroll.LayoutOrder = 9
		logScroll.ScrollBarThickness = 2; logScroll.ScrollBarImageColor3 = C.accentDim
		logScroll.CanvasSize = UDim2.new(0,0,0,0); logScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
		mkCorner(logScroll, 8); mkStroke(logScroll, C.border); mkPad(logScroll, 6)
		mkList(logScroll, Enum.FillDirection.Vertical, 2)
	
		local logCount = 0
		local function addLog(txt, col)
			local e = Instance.new("TextLabel", logScroll)
			e.Size = UDim2.new(1, 0, 0, 14); e.BackgroundTransparency = 1
			e.Text = os.date("%H:%M:%S") .. "  " .. txt; e.TextSize = 10
			e.TextColor3 = col or C.sub; e.Font = FR
			e.TextXAlignment = Enum.TextXAlignment.Left; e.LayoutOrder = logCount
			logCount = logCount + 1
			task.defer(function()
				logScroll.CanvasPosition = Vector2.new(0, logScroll.AbsoluteCanvasSize.Y)
			end)
		end
	
		-- ============================================================
		--  PAGE 2 — SERVERS (new)
		-- ============================================================
		local page2, p2 = makePage()
		local updateVisitedCount
	
		secHeader(p2, "SERVER LIST", 1)
		local SORT_OPTIONS = {
			{ display = "Players · low → high (asc)", value = "LowPop" },
			{ display = "Players · high → low (desc)", value = "HighPop" },
			{ display = "API order · oldest first (asc)", value = "OldestFirst" },
			{ display = "API order · newest first (desc)", value = "NewestFirst" },
			{ display = "Random hop order", value = "Random" },
		}
		mkDropdown(p2, "HOP ORDER (after fetch)", SORT_OPTIONS, cfg.sortMode, function(v) cfg.sortMode = v end, 2)
	
		mkDropdown(p2, "ROBLOX API sortOrder", {
			{ display = "Ascending (default chunk)", value = "Asc" },
			{ display = "Descending (reverse chunk)", value = "Desc" },
		}, cfg.apiSortOrder or "Asc", function(v) cfg.apiSortOrder = v end, 3)
	
		mkDropdown(p2, "SERVER TYPE", {
			{ display = "Public", value = "Public" },
			{ display = "Friends", value = "Friends" },
		}, cfg.serverType, function(v) cfg.serverType = v end, 4)
	
		mkSlider(p2, "Servers per request (API)", 10, 100, cfg.serverListLimit or 100, 10,
			function(v) cfg.serverListLimit = v end, 5)
	
		mkSlider(p2, "Min players in server", 0, 100, cfg.minPlayers or 0, 1, function(v) cfg.minPlayers = v end, 6)
		mkSlider(p2, "Max players in server", 1, 200, math.clamp(cfg.maxPlayers or 200, 1, 200), 1, function(v) cfg.maxPlayers = v end, 7)
	
		mkToggle(p2, "Shuffle hop list", "Randomize order after sort (not used when hop order = Random)", cfg.shuffleServers, function(v) cfg.shuffleServers = v end, 8)
	
		secHeader(p2, "REJOIN (REAL-WORLD TIME)", 9)
		mkToggle(p2, "Skip previously visited", "Uses os.time() — not session length. Cooldown below.", cfg.skipPrevious, function(v) cfg.skipPrevious = v end, 10)
		mkSlider(p2, "Rejoin cooldown (minutes)", 5, 240, math.floor((cfg.rejoinCooldown or 3600) / 60), 5,
			function(v) cfg.rejoinCooldown = v * 60 end, 11)
		mkToggle(p2, "Remember visits on disk", "File: " .. VISITS_FILE .. " (executor workspace)", cfg.persistVisitHistory ~= false, function(v)
			cfg.persistVisitHistory = v
			if v then
				visitedServers = loadVisitsFromDisk()
			end
			saveConfig(cfg)
			if v then flushVisitsToDisk() end
			updateVisitedCount()
		end, 12)
	
		secHeader(p2, "VISITED JOBIDS", 13)
	
		local visitedCountLbl = Instance.new("Frame", p2)
		visitedCountLbl.Size = UDim2.new(1, 0, 0, 38); visitedCountLbl.BackgroundColor3 = C.card
		visitedCountLbl.BorderSizePixel = 0; visitedCountLbl.LayoutOrder = 14
		mkCorner(visitedCountLbl, 8); mkStroke(visitedCountLbl, C.border)
		local vcLbl = Instance.new("TextLabel", visitedCountLbl)
		vcLbl.Size = UDim2.new(1, -20, 1, 0); vcLbl.Position = UDim2.new(0, 10, 0, 0)
		vcLbl.BackgroundTransparency = 1; vcLbl.TextSize = 12; vcLbl.TextColor3 = C.txt
		vcLbl.Font = FS; vcLbl.TextXAlignment = Enum.TextXAlignment.Left
		vcLbl.Text = "Tracked visits: …"
	
		local clearVisited = Instance.new("Frame", p2)
		clearVisited.Size = UDim2.new(1, 0, 0, 38); clearVisited.BackgroundTransparency = 1
		clearVisited.LayoutOrder = 15
		local cvBtn = Instance.new("TextButton", clearVisited)
		cvBtn.Size = UDim2.new(1, 0, 1, 0); cvBtn.BackgroundColor3 = C.accentDim
		cvBtn.Text = "CLEAR VISITED LIST"; cvBtn.TextSize = 12; cvBtn.TextColor3 = C.accent
		cvBtn.Font = FB; cvBtn.BorderSizePixel = 0
		mkCorner(cvBtn, 8); mkStroke(cvBtn, C.accent)
		cvBtn.MouseButton1Click:Connect(function()
			visitedServers = {}
			flushVisitsToDisk()
			updateVisitedCount()
			addLog("↺ Visited server list cleared (and disk file if enabled)", C.warn)
		end)
	
		updateVisitedCount = function()
			local count = 0
			for _ in pairs(visitedServers) do count = count + 1 end
			local disk = (cfg.persistVisitHistory ~= false) and " · saved to disk" or " · memory only"
			vcLbl.Text = "Tracked visits: " .. count .. " jobIds" .. disk
		end
		updateVisitedCount()
	
