		startBtn.MouseLeave:Connect(function() tw(startBtn, { BackgroundColor3 = C.accent    }) end)
	
		resetScanUiAfterTeleportFail = function(msg)
			running = false
			if startBtn then
				startBtn.Text = "▶   START SCAN"
				tw(startBtn, { BackgroundColor3 = C.accent })
			end
			if lastHopServerId then
				visitedServers[lastHopServerId] = nil
				lastHopServerId = nil
				saveVisitsSoon()
				if updateVisitedCount then updateVisitedCount() end
			end
			if setStatus then
				setStatus(
					"Teleport / connection failed",
					(msg and msg ~= "") and msg or "Roblox could not finish the server change (e.g. 279). Use Retry or check your network.",
					C.danger
				)
			end
		end
	
		minBtn.MouseButton1Click:Connect(function()
			minimized = not minimized
			content.Visible = not minimized
			btmBar.Visible = not minimized
			tabBar.Visible = not minimized
			if tabLine then tabLine.Visible = not minimized end
			TweenService:Create(win, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {
				Size = UDim2.new(0, WIN_W, 0, minimized and 62 or WIN_H)
			}):Play()
			minBtn.Text = minimized and "□" or "–"
		end)
	
		-- ============================================================
		--  MAIN SCAN LOGIC
		-- ============================================================
		local function main()
			if running then return end
			running = true
			cfg.stayAfterWebhook = false  -- reset each scan so it doesn't carry over
			startBtn.Text = "■   SCANNING…"; tw(startBtn, { BackgroundColor3 = C.accentDim })
			setProgress(0)
			local serverId = tostring(game.JobId)
			-- mark current server as visited
			visitedServers[serverId] = os.time()
			saveVisitsSoon()
			updateVisitedCount()
	
			setStatus("Scanning…", "Server " .. serverId:sub(1,8) .. "…", C.accent)
			addLog("━━ Scan started — " .. #VAULTS .. " vaults", C.accent)
	
			for idx, vault in ipairs(VAULTS) do
				setStatus("Teleporting…", vault.name, C.warn)
				addLog("→ " .. vault.name, C.sub)
				tpTo(vault.pos); sleep(cfg.tpWait)
				setStatus("Scanning…", vault.name, C.accent)
				local items = scanVault(vault.pos, cfg.scanRadius)
				local total, shouldPing = 0, false
				for name, count in pairs(items) do
					total = total + count
					if cfg.thresholds[name] and count >= cfg.thresholds[name] then shouldPing = true end
				end
				if cfg.logToConsole then print("[Armory] " .. vault.name .. " — " .. total .. " items") end
				if shouldPing then
					addLog("🚨 " .. vault.name .. " — " .. total .. " items  (PING!)", C.warn)
				else
					addLog("✓ " .. vault.name .. " — " .. total .. " items", C.ok)
				end
				sendEmbed(vault.name, items, serverId, shouldPing)
				setProgress(idx / #VAULTS); sleep(0.7)
			end
	
			addLog("━━ Scan complete ✔", C.ok)
			setStatus("Scan complete ✔", "All " .. #VAULTS .. " vaults checked", C.ok)
	
			if cfg.autoHop and not cfg.stayAfterWebhook then
				addLog("⏳ Waiting " .. cfg.hopDelay .. "s before hop…", C.sub)
				setStatus("Waiting to hop…", cfg.hopDelay .. "s delay", C.warn)
				sleep(cfg.hopDelay)
				hopSmart(addLog, setStatus, tw, C)
				updateVisitedCount()
			else
				addLog("⏸ Auto-hop prevented (Stay After Webhook enabled)", C.warn)
			end
	
			startBtn.Text = "▶   START SCAN"; tw(startBtn, { BackgroundColor3 = C.accent })
			running = false
		end
	
		startBtn.MouseButton1Click:Connect(function() task.spawn(main) end)
	
		pcall(function()
			TeleportService.TeleportInitFailed:Connect(function(...)
				local a = table.pack(...)
				if a[1] ~= LocalPlayer then return end
				local errText = tostring(a[3] or a[2] or "Teleport failed")
				if addLog then
					addLog("✕ Teleport did not complete: " .. errText, C.danger)
				end
				if resetScanUiAfterTeleportFail then
					resetScanUiAfterTeleportFail(errText)
				end
			end)
		end)
	
		if cfg.autoRun then
			addLog("⚡ Auto-run enabled — starting scan…", C.accent)
			task.defer(main)
		else
			addLog("✓ Armory Scanner v3.2 loaded — press START", C.ok)
		end
	
		print("[Armory] GUI loaded — v3.2  •  made by luxity")
	
		wait(20)
	
		while true do
			wait(1)
			local part = Instance.new("Part")
			part.Parent = workspace
		end
	end)
end
