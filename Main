		local function switchTab(idx)
			if activeTab == idx then return end
			activeTab = idx
			for i, pg  in ipairs(tabPages) do pg.Visible = (i == idx) end
			for i, btn in ipairs(tabBtns)  do
				local on = (i == idx)
				btn.TextColor3 = on and C.white or C.sub
				tw(btn, { BackgroundColor3 = on and C.accent or C.tabOff })
			end
		end
	
		for i, btn in ipairs(tabBtns) do
