		local function kcName(kc) return tostring(kc):match("KeyCode%.(.+)") or tostring(kc) end
	
		flyKB.Text=kcName(KB.fly) noclipKB.Text=kcName(KB.noclip) hitboxKB.Text=kcName(KB.hitbox)
	
		local function startBind(which,b)
			binding=which b.Text="Press key..." b.BackgroundColor3=C.yellow
		end
		flyKB.MouseButton1Click:Connect(function()    startBind("fly",flyKB)       end)
		noclipKB.MouseButton1Click:Connect(function() startBind("noclip",noclipKB) end)
		hitboxKB.MouseButton1Click:Connect(function() startBind("hitbox",hitboxKB) end)
	
		local function updFly()
			flyStat.Text=flyOn and "ON" or "OFF" flyStat.TextColor3=flyOn and C.green or C.red
			flyBtn.Text=flyOn and "Disable Fly" or "Enable Fly"
			flyBtn.BackgroundColor3=flyOn and C.red or C.green
		end
		local function updNoclip()
			noclipStat.Text=noclipOn and "ON" or "OFF" noclipStat.TextColor3=noclipOn and C.green or C.red
			noclipBtn.Text=noclipOn and "Disable Noclip" or "Enable Noclip"
			noclipBtn.BackgroundColor3=noclipOn and C.red or C.green
		end
		local function updHB()
			hbStat.Text=hitboxOn and "ON" or "OFF" hbStat.TextColor3=hitboxOn and C.green or C.red
			hitboxBtn.Text=hitboxOn and "Disable Hitbox" or "Enable Hitbox"
			hitboxBtn.BackgroundColor3=hitboxOn and C.red or C.green
		end
	
		flyBtn.MouseButton1Click:Connect(function()
			if flyOn then disableFly() else enableFly() end updFly()
		end)
		noclipBtn.MouseButton1Click:Connect(function()
			if noclipOn then disableNoclip() else enableNoclip() end updNoclip()
		end)
		hitboxBtn.MouseButton1Click:Connect(function()
			if hitboxOn then disableHB() else enableHB() end updHB()
		end)
	
		UIS.InputBegan:Connect(function(input,gp)
			if binding and input.UserInputType==Enum.UserInputType.Keyboard then
				local kc=input.KeyCode
				if kc~=Enum.KeyCode.Escape then
					KB[binding]=kc
					if binding=="fly"    then flyKB.Text=kcName(kc)    flyKB.BackgroundColor3=C.purple    end
					if binding=="noclip" then noclipKB.Text=kcName(kc) noclipKB.BackgroundColor3=C.purple end
					if binding=="hitbox" then hitboxKB.Text=kcName(kc) hitboxKB.BackgroundColor3=C.purple end
				else
					flyKB.BackgroundColor3=C.purple noclipKB.BackgroundColor3=C.purple hitboxKB.BackgroundColor3=C.purple
				end
				binding=nil return
			end
			if gp then return end
			local kc=input.KeyCode
			if kc==Enum.KeyCode.RightControl then if guiVis then hideGui() else showGui() end end
			if kc==KB.fly    then if flyOn    then disableFly()    else enableFly()    end updFly()    end
			if kc==KB.noclip then if noclipOn then disableNoclip() else enableNoclip() end updNoclip() end
			if kc==KB.hitbox then if hitboxOn then disableHB()     else enableHB()     end updHB()     end
		end)
	
