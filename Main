		secHeader(p4, "ADD CUSTOM ITEM", 20)
		local _, newNameBox = mkInput(p4, "ITEM NAME  (match DEX exactly)", "e.g. MP5K, AUG, G36", "", nil, 21)
		local _, newQtyBox  = mkInput(p4, "MINIMUM COUNT", "1", "1", nil, 22)
	
		local addF = Instance.new("Frame", p4)
		addF.Size = UDim2.new(1,0,0,38); addF.BackgroundTransparency = 1; addF.LayoutOrder = 23
		local addBtn = Instance.new("TextButton", addF)
		addBtn.Size = UDim2.new(1,0,1,0); addBtn.BackgroundColor3 = C.card
		addBtn.Text = "+ ADD THRESHOLD"; addBtn.TextSize = 12; addBtn.TextColor3 = C.accent
		addBtn.Font = FB; addBtn.BorderSizePixel = 0
		mkCorner(addBtn, 8); mkStroke(addBtn, C.accent)
		addBtn.MouseButton1Click:Connect(function()
			local name = newNameBox.Text
			local qty  = tonumber(newQtyBox.Text) or 1
			if name ~= "" then
				cfg.thresholds[name] = qty; saveConfig(cfg)
				mkThreshRow(p4, name, qty, function(n) cfg.thresholds[name] = n end, thOrd)
				thOrd = thOrd + 1; newNameBox.Text = ""; newQtyBox.Text = "1"
				addLog("+ Threshold: " .. name .. " × " .. qty, C.ok)
			end
		end)
	
		-- ============================================================
		--  PAGE 5 — SETTINGS
		-- ============================================================
		local page5, p5 = makePage()
	
		secHeader(p5, "SCANNING", 1)
		mkSlider(p5, "Scan Radius (studs)", 50, 500, cfg.scanRadius, 10, function(v) cfg.scanRadius = v end, 2)
		mkSlider(p5, "Teleport Wait (seconds)", 1, 15, cfg.tpWait, 0.5, function(v) cfg.tpWait = v end, 3, function(x)
			return string.format("%.1f", x)
		end)
	
		secHeader(p5, "SERVER HOPPING", 4)
	
		mkToggle(p5, "Auto Server Hop",
			"Hop to a new server after all vaults scanned",
			cfg.autoHop,
			function(v) cfg.autoHop = v end,
			5
		)
	
		mkSlider(p5, "Hop Delay (s)",
			1, 60,
			cfg.hopDelay,
			1,
			function(v) cfg.hopDelay = v end,
			6
		)
	
		mkToggle(p5, "Stay in server after webhook",
			"Prevents auto-hop after sending a Discord webhook",
			cfg.stayAfterWebhook,
			function(v) cfg.stayAfterWebhook = v end,
			7
		)
	
		mkToggle(p5, "Stop hop on Discord ping",
			"Pause auto-hopping when a threshold item triggers a ping",
			true,
			function(v) pauseOnPing = v end,
			8
		)
	
		mkSlider(p5, "Wait after webhook (seconds)",
			0, 60,
