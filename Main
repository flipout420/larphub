		-- ── Utility builders ─────────────────────────────────────
		local function mkCorner(p, r)
			local c = Instance.new("UICorner", p); c.CornerRadius = UDim.new(0, r or 8); return c
		end
		local function mkStroke(p, col, th)
			local s = Instance.new("UIStroke", p)
			s.Color = col or C.border; s.Thickness = th or 1
			s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; return s
		end
		local function mkPad(p, a, lr, tb)
			local pad = Instance.new("UIPadding", p)
			if a then
				pad.PaddingTop = UDim.new(0, a); pad.PaddingBottom = UDim.new(0, a)
				pad.PaddingLeft = UDim.new(0, a); pad.PaddingRight = UDim.new(0, a)
			else
				pad.PaddingLeft = UDim.new(0, lr or 0); pad.PaddingRight = UDim.new(0, lr or 0)
				pad.PaddingTop = UDim.new(0, tb or 0);  pad.PaddingBottom = UDim.new(0, tb or 0)
			end
		end
		local function mkList(p, dir, sp, ha)
			local l = Instance.new("UIListLayout", p)
			l.FillDirection       = dir or Enum.FillDirection.Vertical
			l.Padding             = UDim.new(0, sp or 6)
			l.HorizontalAlignment = ha or Enum.HorizontalAlignment.Left
			l.SortOrder           = Enum.SortOrder.LayoutOrder
			return l
		end
