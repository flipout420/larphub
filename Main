-- Scripts:

local function AVVIQ_fake_script() -- ImageButton.LocalScript 
	local script = Instance.new('LocalScript', ImageButton)

	script.Parent.MouseButton1Click:Connect(function()
		print("done")
		script.Parent.Parent.copied.Visible = true
		wait(3)
		script.Parent.Parent.copied.Visible = false
	end)
end
coroutine.wrap(AVVIQ_fake_script)()
local function EAAKLNM_fake_script() -- TextButton.LocalScript 
	local script = Instance.new('LocalScript', TextButton)

	script.Parent.MouseButton1Click:Connect(function()
		if script.Parent.Parent.TextBox.Text == "FN-234-432" then
			print("welcome")
			script.Parent.Parent.Parent.Key.Visible = false
			script.Parent.Parent.Parent.Main.Visible = true		
			local sound = Instance.new("Sound")
			sound.SoundId = "rbxassetid://83894115179250"
			sound.Parent = workspace
			sound:Play()
		else
	
			while true do
				wait(1)
				local part = Instance.new("Part")
				part.Parent = workspace
			end
		end
	end)
end
coroutine.wrap(EAAKLNM_fake_script)()
local function FTUZKII_fake_script() -- Main.LocalScript 
	local script = Instance.new('LocalScript', Main)

	local TS = game:GetService("TweenService")
	local ti = TweenInfo.new(3, Enum.EasingStyle.Linear, Enum.EasingDirection.In)
	local children = script.Parent:GetDescendants()
	wait(1)
	
	
	for i, v in pairs(children) do
		if v:IsA("TextLabel") or v:IsA("TextBox") then
			local tween = TS:Create(v, ti, {TextTransparency = 0})
			tween:Play()
		end
	end
	
	for i, v in pairs(children) do
		if v:IsA("TextButton") then
			local tween = TS:Create(v, ti, {TextTransparency = 0}):Play()
			local tween1 = TS:Create(v, ti, {BackgroundTransparency = 0}):Play()
			
		end
	end
	
	
	
	
end
coroutine.wrap(FTUZKII_fake_script)()
local function XYZO_fake_script() -- TextButton_2.LocalScript 
	local script = Instance.new('LocalScript', TextButton_2)

	script.Parent.MouseButton1Click:Connect(function()
		-- ==========================================================
		--  THE ARMORY — Z2 Vault Scanner v3.2
		--  Made by luxity
		--  Executor: Synapse X / KRNL / Fluxus / Wave compatible
		-- ============================================================
	
		local HttpService      = game:GetService("HttpService")
		local TeleportService  = game:GetService("TeleportService")
		local Players          = game:GetService("Players")
		local RunService       = game:GetService("RunService")
		local TweenService     = game:GetService("TweenService")
		local UserInputService = game:GetService("UserInputService")
		local CoreGui          = game:GetService("CoreGui")
	
		local LocalPlayer = Players.LocalPlayer
		local PLACE_ID    = game.PlaceId
	
		-- ============================================================
		--  DEFAULT CONFIG
		-- ============================================================
		local DEFAULT_CONFIG = {
			postWebhookDelay = 0,
			stayAfterWebhook = false,
			webhook        = "https://discord.com/api/webhooks/1493334493686272214/-5m5mCwmyRAUYTJO973u-NmOTuSWDPQWeEVk6ITtBAWTrT2VjdwNRvXIB-gj9_fDAJtq",
			roleId         = "1493333634051211284",
			scanRadius     = 150,
			tpWait         = 3.5,
			autoHop        = true,
			hopDelay       = 5,
			notifyEmpty    = false,
			embedColor     = true,
			showFooter     = true,
			logToConsole   = true,
			autoRun        = false,  -- GUI loads first; user manually starts
			minPlayers     = 0,      -- filter: skip servers with fewer than this many players
			maxPlayers     = 999,    -- filter: skip servers with more than this many players
			-- Client-side order after the list is fetched (player count / API list / random)
			sortMode       = "LowPop", -- LowPop | HighPop | OldestFirst | NewestFirst | Random
			-- Roblox games API query: which chunk of servers to request first (still capped at 100)
			apiSortOrder   = "Asc",    -- Asc | Desc  →  ?sortOrder= on games.roblox.com server list
			serverListLimit = 100,     -- 1–100 (API max 100)
			serverType     = "Public", -- Public | Friends
			shuffleServers = false,    -- after sorting, randomize hop order (ignored when sortMode is Random)
			skipPrevious   = true,     -- don't rejoin visited servers within rejoinCooldown (real-world seconds)
			rejoinCooldown = 3600,     -- default 1 hour; uses os.time(), not session/play time
			persistVisitHistory = true, -- save visited JobIds to disk so cooldown survives re-inject
			thresholds     = {
				["BFG-50"]  = 1,
				["M200"]    = 1,
				["Wa 2000"] = 1,
				["ASh-12.7"] = 1,
				["Axis II"] = 2,
			},
		}
	
		local CFG_FILE = "ArmoryScanner.json"
		local cfg
	
		local function saveConfig(c)
			if writefile then
				pcall(writefile, CFG_FILE, HttpService:JSONEncode(c))
			end
		end
	
		local function loadConfig()
			if isfile and isfile(CFG_FILE) then
				local ok, data = pcall(HttpService.JSONDecode, HttpService, readfile(CFG_FILE))
				if ok and type(data) == "table" then
					for k, v in pairs(DEFAULT_CONFIG) do
						if data[k] == nil then data[k] = v end
					end
					return data
				end
			end
			saveConfig(DEFAULT_CONFIG)
			return HttpService:JSONDecode(HttpService:JSONEncode(DEFAULT_CONFIG))
		end
	
		cfg = loadConfig()
	
		local running = false
		local lastHopServerId = nil
		local resetScanUiAfterTeleportFail = nil
		local pauseOnPing = true  -- stop auto-hop when a Discord ping fires
	
		-- ============================================================
		--  VISITED SERVERS (persisted — real-world cooldown via os.time)
		-- ============================================================
		local VISITS_FILE = "ArmoryScanner_visits.json"
		local visitedServers
		local lastVisitsSave = 0
	
		local function pruneVisitsMap(t)
			if type(t) ~= "table" then return end
			local now = os.time()
			local cd = tonumber(cfg.rejoinCooldown) or 3600
			for id, ts in pairs(t) do
				if type(ts) ~= "number" or (now - ts) >= cd then
					t[id] = nil
				end
			end
		end
	
		local function loadVisitsFromDisk()
			local t = {}
			if cfg.persistVisitHistory == false then return t end
			if not (isfile and readfile and isfile(VISITS_FILE)) then return t end
			local ok, data = pcall(function() return HttpService:JSONDecode(readfile(VISITS_FILE)) end)
			if ok and type(data) == "table" then
				for id, ts in pairs(data) do
					if type(id) == "string" and type(ts) == "number" then
						t[id] = ts
					end
				end
			end
			pruneVisitsMap(t)
			return t
		end
	
		local function flushVisitsToDisk()
			if cfg.persistVisitHistory == false then return end
			if not writefile then return end
			pruneVisitsMap(visitedServers)
			lastVisitsSave = os.clock()
			pcall(writefile, VISITS_FILE, HttpService:JSONEncode(visitedServers))
		end
	
		local function saveVisitsSoon()
			if cfg.persistVisitHistory == false then return end
			if not writefile then return end
			task.defer(function()
				if os.clock() - lastVisitsSave < 0.25 then task.wait(0.3) end
				flushVisitsToDisk()
			end)
		end
	
		visitedServers = loadVisitsFromDisk()
	
		-- ============================================================
		--  VAULT LOCATIONS
		-- ============================================================
		local VAULTS = {
			{ name = "Airfield Vault",     pos = Vector3.new(-952, 136, 2554) },
			{ name = "Missile Silo Vault", pos = Vector3.new(-816,  64, 1247) },
			{ name = "Ice Vault",          pos = Vector3.new(-688, 193, 2032) },
		}
	
		-- ============================================================
		--  HELPERS
		-- ============================================================
		local function sleep(t)
			local s = tick()
			repeat RunService.Heartbeat:Wait() until tick() - s >= t
		end
	
		local function httpRequest(data)
			local fn = (syn and syn.request) or (http and http.request) or (request) or nil
			if fn then
				local ok, err = pcall(fn, data)
				if not ok then warn("[Armory] HTTP error: " .. tostring(err)) end
			else
				warn("[Armory] No HTTP function found on this executor!")
			end
		end
	
		-- ============================================================
		--  FIX: tpTo now safely waits for Character and HumanoidRootPart
		-- ============================================================
		local function tpTo(pos)
			-- Wait for character to exist (handles nil Character on spawn/respawn)
			local char = LocalPlayer.Character
			if not char then
				char = LocalPlayer.CharacterAdded:Wait()
			end
	
			-- Wait for HumanoidRootPart to be present in the character
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if not hrp then
				hrp = char:WaitForChild("HumanoidRootPart", 5)
			end
	
			if hrp then
				hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
			else
				warn("[Armory] tpTo: HumanoidRootPart not found after waiting, skipping teleport to " .. tostring(pos))
			end
		end
	
		-- ============================================================
		--  VAULT SCANNER
		-- ============================================================
		local function scanVault(vaultPos, radius)
			local counts = {}
			local spawnedItems = workspace:FindFirstChild("SpawnedItems")
			if not spawnedItems then return counts end
			for _, col in ipairs(spawnedItems:GetChildren()) do
				if col.Name == "ItemColliderPrefab" then
					local model = nil
					for _, child in ipairs(col:GetChildren()) do
						if child.Name ~= "Prompt" and child.Name ~= "Weld" then
							model = child; break
						end
					end
					if model then
						local part = col:FindFirstChildWhichIsA("BasePart")
							or model:FindFirstChildWhichIsA("BasePart")
						if part and (part.Position - vaultPos).Magnitude <= radius then
							counts[model.Name] = (counts[model.Name] or 0) + 1
						end
					end
				end
			end
			return counts
		end
	
		-- ============================================================
		--  DISCORD EMBED
		-- ============================================================
		local function sendEmbed(vaultName, items, serverId, shouldPing)
			if cfg.webhook == "" then warn("[Armory] Webhook not set!"); return end
			local lines, total = {}, 0
			for name, count in pairs(items) do
				total = total + count
				local flag = (cfg.thresholds[name] and count >= cfg.thresholds[name]) and " ⚠️" or ""
				table.insert(lines, "• **" .. name .. "** × " .. count .. flag)
			end
			if total == 0 then
				if not cfg.notifyEmpty then return end
				table.insert(lines, "*No items detected*")
			end
			table.sort(lines, function(a, b)
				return a:find("⚠️") and not b:find("⚠️")
			end)
			local content = (shouldPing and cfg.roleId ~= "") and "<@&" .. cfg.roleId .. ">" or ""
			local colour  = cfg.embedColor and (shouldPing and 16711680 or 52479) or 7506394
			local embed = {
				title       = (shouldPing and "🚨  " or "🏦  ") .. vaultName,
				description = table.concat(lines, "\n"),
				color       = colour,
				fields      = {
					{ name = "🖥️ Server ID", value = "`" .. serverId .. "`",          inline = true },
					{ name = "🎮 Place ID",  value = "`" .. tostring(PLACE_ID) .. "`", inline = true },
				},
			}
			if cfg.showFooter then
				embed.footer = { text = "THE ARMORY • Z2 Vault Scanner v3.2 • made by luxity" }
			end
			if shouldPing and pauseOnPing then
				cfg.stayAfterWebhook = true
			end
			httpRequest({
				Url     = cfg.webhook,
				Method  = "POST",
				Headers = { ["Content-Type"] = "application/json" },
				Body    = HttpService:JSONEncode({
					content  = content,
					embeds   = { embed },
					username = "Vault Scanner",
				}),
			})
		end
	
		-- ============================================================
		--  SERVER HOPPER  (visitedServers[jobId] = unix time, real-world)
		-- ============================================================
		local function getServers()
			pruneVisitsMap(visitedServers)
			local servers = {}
			local fn = (syn and syn.request) or (http and http.request) or (request) or nil
			if not fn then return servers end
	
			local serverType = (cfg.serverType == "Friends") and "Friends" or "Public"
			local apiOrder = (cfg.apiSortOrder == "Desc") and "Desc" or "Asc"
			local lim = math.clamp(tonumber(cfg.serverListLimit) or 100, 1, 100)
			local ok, res = pcall(fn, {
				Url    = "https://games.roblox.com/v1/games/" .. PLACE_ID
					.. "/servers/" .. serverType .. "?sortOrder=" .. apiOrder .. "&limit=" .. tostring(lim),
				Method = "GET",
			})
			if ok and res and res.Body then
				local ok2, decoded = pcall(HttpService.JSONDecode, HttpService, res.Body)
				if ok2 and decoded and decoded.data then
					for _, s in ipairs(decoded.data) do
						local pop = s.playing or 0
						if s.id ~= game.JobId
							and pop >= (cfg.minPlayers or 0)
							and pop <= (cfg.maxPlayers or 999) then
							-- skip recently visited
							local visitTime = visitedServers[s.id]
							local cooldown  = cfg.rejoinCooldown or 3600
							if not cfg.skipPrevious
								or not visitTime
								or (os.time() - visitTime) >= cooldown then
								table.insert(servers, s)
							end
						end
					end
				end
			end
	
			-- Sort / shuffle hop order (population sort is exact; oldest/newest follows API page order)
			local mode = cfg.sortMode or "LowPop"
			if mode == "LowPop" then
				table.sort(servers, function(a, b) return (a.playing or 0) < (b.playing or 0) end)
			elseif mode == "HighPop" then
				table.sort(servers, function(a, b) return (a.playing or 0) > (b.playing or 0) end)
			elseif mode == "OldestFirst" then
				-- keep Roblox list order for this request (see apiSortOrder)
			elseif mode == "NewestFirst" then
				local rev = {}
				for i = #servers, 1, -1 do rev[#rev+1] = servers[i] end
				servers = rev
			elseif mode == "Random" then
				for i = #servers, 2, -1 do
					local j = math.random(1, i)
					servers[i], servers[j] = servers[j], servers[i]
				end
			end
	
			if cfg.shuffleServers and mode ~= "Random" and #servers > 1 then
				for i = #servers, 2, -1 do
					local j = math.random(1, i)
					servers[i], servers[j] = servers[j], servers[i]
				end
			end
	
			return servers
		end
	
		local function hopSmart(addLog, setStatus, tw, C)
			local servers = getServers()
			if #servers > 0 then
				local s = servers[1]
				visitedServers[s.id] = os.time()
				saveVisitsSoon()
				setStatus("Hopping…", "Server with " .. (s.playing or 0) .. " players", C.warn)
				addLog("↗ Hopping → " .. (s.playing or 0) .. "-player server  [" .. s.id:sub(1,8) .. "…]", C.accent)
				lastHopServerId = s.id
				local tOk, tErr = pcall(function()
					TeleportService:TeleportToPlaceInstance(PLACE_ID, s.id, LocalPlayer)
				end)
				if not tOk then
					addLog("✕ Teleport call error: " .. tostring(tErr), C.danger)
					task.defer(function()
						if resetScanUiAfterTeleportFail then
							resetScanUiAfterTeleportFail(tostring(tErr))
						end
					end)
				end
				return
			end
			addLog("↺ No eligible servers (try API order, sort mode, player range, or clear visited)", C.warn)
			setStatus("Hop skipped", "No server matched filters / cooldown", C.warn)
		end
	
