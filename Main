				saveBtn.LayoutOrder=1
				local loadBtn=mkBtn(cfgBtnRow,"Load",UDim2.new(0,90,1,0),UDim2.new(0,0,0,0),C.purple,11)
				loadBtn.LayoutOrder=2
				local delBtn=mkBtn(cfgBtnRow,"Delete",UDim2.new(0,90,1,0),UDim2.new(0,0,0,0),C.red,11)
				delBtn.LayoutOrder=3
	
				local cfgListCard=card(cfg,2) secLbl(cfgListCard,"SAVED CONFIGS",1)
				local cfgListSf=Instance.new("ScrollingFrame")
				cfgListSf.Size=UDim2.new(1,0,0,120)
				cfgListSf.BackgroundColor3=C.slBg cfgListSf.BorderSizePixel=0
				cfgListSf.ScrollBarThickness=3 cfgListSf.ScrollBarImageColor3=C.acc1
				cfgListSf.CanvasSize=UDim2.new(0,0,0,0) cfgListSf.AutomaticCanvasSize=Enum.AutomaticSize.Y
				cfgListSf.LayoutOrder=2 cfgListSf.Parent=cfgListCard cr(cfgListSf,6)
