		-- CONFIGS TAB
		do
			local cfg=tFrames["Configs"]
			do
				local function saveConfig(name) return saveConfigData(name) end
				local function loadConfig(name) return loadConfigData(name) end
	
				local function listConfigs()
					if not listfiles then return {} end
					local list={}
					local ok,files=pcall(listfiles,"")
					if ok then
						for _,f in ipairs(files) do
							local name=f:match("(.+)%.json$")
							if name and name:sub(1,4)~="sys_" then
								list[#list+1]=name
							end
						end
					end
					return list
				end
	
				local cfgSaveCard=card(cfg,1) secLbl(cfgSaveCard,"SAVE CONFIG",1)
				local cfgNameRow=row(cfgSaveCard,2,32)
				local cfgNameBox=Instance.new("TextBox")
				cfgNameBox.Size=UDim2.new(1,0,1,0) cfgNameBox.BackgroundColor3=C.slBg
				cfgNameBox.BorderSizePixel=0 cfgNameBox.Text="myconfig"
				cfgNameBox.TextColor3=C.textP cfgNameBox.Font=Enum.Font.Gotham
				cfgNameBox.TextSize=11 cfgNameBox.PlaceholderText="Config name..."
				cfgNameBox.PlaceholderColor3=C.textD cfgNameBox.Parent=cfgNameRow cr(cfgNameBox,6)
