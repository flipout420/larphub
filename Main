			hrp      = char:WaitForChild("HumanoidRootPart")
			humanoid = char:WaitForChild("Humanoid")
			cam      = workspace.CurrentCamera
		end
	
		if plr.Character then refreshChar(plr.Character) end
		plr.CharacterAdded:Connect(refreshChar)
		cam = workspace.CurrentCamera
	
		local sellRemote = RS:WaitForChild("Remotes"):WaitForChild("ClientSellRequest")
		local shopRemote = RS:WaitForChild("Remotes"):WaitForChild("ShopPurchaseRequest")
		local crates        = workspace:WaitForChild("SpawnedCrates")
		local spawnedItems  = workspace:WaitForChild("SpawnedItems")
	
		-- VAULT ZONES
		local VAULTS = {
			{x=-576,  y=70,  z=1056, name="Rooftop :Z1"},
			{x=-952,  y=136, z=2554, name="Airfield Vault :Z2"},
			{x=-816,  y=64,  z=1247, name="Missle Silo :Z2"},
			{x=-688,  y=193, z=2032, name="Ice Vault :Z2"},
			{x=-69,   y=47,  z=909,  name="Cave Vault :Z1"},
			{x=-657,  y=6,   z=873,  name="Small Factory :Z1"},
			{x=640,   y=2,   z=1238, name="Small Airfield :Z1"},
			{x=-230,  y=1,   z=841,  name="Small Tent :Z1"},
		}
		local VAULT_RADIUS = 14
	
		local function inVault(crate)
			local pos
			local root = crate:FindFirstChild("Root")
			if root and root:IsA("BasePart") then
				pos = root.Position
			else
				for _, p in ipairs(crate:GetDescendants()) do
					if p:IsA("BasePart") and not p.Locked then pos = p.Position break end
				end
			end
			if not pos then return false end
			for _, z in ipairs(VAULTS) do
				if (pos - Vector3.new(z.x, z.y, z.z)).Magnitude <= VAULT_RADIUS then
					return true
				end
			end
			return false
		end
	
		-- SETTINGS
		local S = {
			SELL_INTERVAL=1, MAX_SLOTS=20, STAND_OFFSET=3,
			TP_SETTLE=0.05, OPEN_WAIT=0.8, COLLECT_WAIT=0.03,
			COLLECT_TRIPS=5, E_PRESS_WAIT=0.03, STUCK_TIMEOUT=15,
			CRATE_RUN_DURATION=10, WAYPOINT_REST=3, WAYPOINT_TP_COUNT=10,
			NUM_WORKERS=1, OPEN_ATTEMPTS_BASE=4, WAYPOINT_TP_INTERVAL=0.05,
			BLACKLIST_TTL=2,
		}
	
		-- CONFIG
		local CONFIG_FILE = "ArmoryAutoFarm_config"
		local saveConfigData, loadConfigData
	
		-- STATE
		local WP         = nil
		local blacklist  = {}
		local blEnabled  = true
		local locked     = {}
		local crateRun   = false
		local cratePause = false
