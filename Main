			local snd=Instance.new("Sound")
			snd.SoundId="rbxassetid://9113386682" snd.Volume=1 snd.Parent=sg snd:Play()
			game:GetService("Debris"):AddItem(snd,6)
			TS:Create(nf,TweenInfo.new(0.3,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{
				Position=UDim2.new(1,-(nw+12),0,72)
			}):Play()
			local gone=false
			local function dismiss()
				if gone then return end gone=true
				TS:Create(nf,TweenInfo.new(0.22,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{
					Position=UDim2.new(1,16,0,72)
				}):Play()
				task.delay(0.25,function() if nf and nf.Parent then nf:Destroy() end end)
			end
			xb.MouseButton1Click:Connect(dismiss)
			task.delay(8,dismiss)
		end
	
		-- GUIDE TAB
		do
			local gd=tFrames["Guide"]
	
			local function guideCard(title,steps,order)
				local gc=card(gd,order) secLbl(gc,title,1)
				for i,step in ipairs(steps) do
					local sr=row(gc,i+1)
					sr.Size=UDim2.new(1,0,0,0)
					sr.AutomaticSize=Enum.AutomaticSize.Y
					local numF=fr(sr,UDim2.new(0,20,0,20),UDim2.new(0,0,0,0),C.acc1,10)
					lb(numF,tostring(i),UDim2.new(1,0,1,0),UDim2.new(0,0,0,0),Color3.new(1,1,1),true,Enum.TextXAlignment.Center,10)
					local tl=Instance.new("TextLabel")
					tl.Size=UDim2.new(1,-28,0,0) tl.Position=UDim2.new(0,26,0,0)
					tl.AutomaticSize=Enum.AutomaticSize.Y
					tl.BackgroundTransparency=1 tl.Text=step
					tl.TextColor3=C.textP tl.Font=Enum.Font.Gotham tl.TextSize=11
					tl.TextXAlignment=Enum.TextXAlignment.Left tl.TextYAlignment=Enum.TextYAlignment.Top
					tl.TextWrapped=true tl.Parent=sr
				end
				return gc
			end
	
			guideCard("CRATES",{
				"Stand somewhere safe, preferably under the map or in a hidden spot, then click Set Waypoint in the Crates tab. The bot teleports back here between runs to avoid detection.",
				"Open the Settings tab and adjust Crate Run Time, Workers, and Rarity filters to your preference. Higher rarities take longer to open — start with defaults.",
				"Select which rarities to farm in the Crates tab toggles. Disable rarities you don't want to waste time on.",
				"Click Start Crates. The bot will auto-teleport to crates, open them, collect loot, and return to your waypoint periodically.",
			},1)
	
			guideCard("ITEMS",{
				"Stand under the map or in a safe spot and click Set Waypoint in the Items tab. This is where the bot returns after grabbing a priority item.",
				"Open the Item Filter card. Click Refresh Item List to populate all items currently spawned in the server.",
				"Toggle items ON that you want to collect. Favorites (★) are always targeted first. Vault items are pushed to the bottom — avoid enabling those as they require vault access.",
				"Add rare guns to Favorites using the ★ button. Favorites auto-stop crating and teleport you back to waypoint when collected.",
				"Click Start Items. The bot scans SpawnedItems, teleports to the nearest enabled item, picks it up, and loops.",
			},2)
	
			guideCard("SELL & SHOP",{
				"The Sell tab auto-fires the sell remote at a set interval. Make sure you are near the sell NPC or have a waypoint set close to it.",
				"Toggle which rarities to sell — disabled rarities are kept in your inventory.",
				"The Shop tab auto-buys solutions (upgrade materials). Enable only the tiers you need to avoid spending cash on unwanted items.",
			},3)
	
			guideCard("CHEATS",{
				"Fly — press F to toggle. Use the speed slider to adjust. Fly low and slow in populated areas to avoid reports.",
				"Noclip — press N to toggle. Lets you walk through walls. Useful for reaching vault areas.",
				"Hitbox — press H to toggle. Enlarges player hitboxes. Use with caution in PvP zones.",
				"Keybinds can be rebound by clicking the key display next to each cheat and pressing your desired key.",
			},4)
	
			guideCard("CONFIGS",{
				"Type a name in the Config Name box and click Save to store all current settings (rarities, sliders, favorites, cheats) to a .json file in your executor's workspace folder.",
				"Click Load to restore a saved config. Click Refresh List to see all saved configs — click any name in the list to select it.",
				"The default config (ArmoryAutoFarm_config) is loaded automatically on script start and auto-saved every 30 seconds.",
			},5)
	
			guideCard("TIPS",{
				"Always set a waypoint under the map before starting. This makes the return teleport invisible to other players.",
				"Use the Blacklist system — crates that fail to open get blacklisted temporarily so the bot skips them and moves on.",
				"If the bot gets stuck, stop and restart. The blacklist clears on each new run.",
				"Vault items tagged (in vault) cannot be collected without vault access — leave those toggled OFF.",
				"Favorite items (ASH 12.7, BFG-50, M200, Purplecard) stop all farming immediately when found and teleport you back to waypoint.",
			},6)
	
		end
	
		-- MISC
		wpSetBtn.MouseButton1Click:Connect(function()
			if hrp then WP=hrp.Position wpLbl.Text="Waypoint: set" wpLbl.TextColor3=C.green end
		end)
		skipBtn.MouseButton1Click:Connect(function()
			blEnabled=not blEnabled
			skipBtn.Text=blEnabled and "ON" or "OFF"
			skipBtn.BackgroundColor3=blEnabled and C.green or C.red
		end)
		task.spawn(function()
			while true do
				local p=game:GetService("ProximityPromptService").PromptShown:Wait()
				if crateRun and not cratePause then fireproximityprompt(p) end
				task.wait()
			end
		end)
	
		spawnedItems.ChildAdded:Connect(function(child)
			task.wait(0.2)
			local n=getItemName(child)
			local inV=inVault(child)
			if STOP_SELL_ITEMS[n] or STOP_TP_ITEMS[n] or favorites[n] then
				crateRun=false cratePause=false wpSpam=false locked={}
				crateBtn.Text="Start Crates" crateBtn.BackgroundColor3=C.green
				cStat.Text="OFF" cStat.TextColor3=C.red
				wpStat.Text="IDLE" wpStat.TextColor3=C.textS
				tmrVal.Text="--" wkVal.Text="0" activeW=0
				if STOP_SELL_ITEMS[n] then
					sellRun=false
					sellBtn.Text="Start Selling" sellBtn.BackgroundColor3=C.green
					sellStat.Text="OFF" sellStat.TextColor3=C.red
				end
				if not inV then
					showFavNotification(n)
					itemFilter[n]=true
					if not itemRun then
						itemRun=true itemLocked={}
						task.spawn(itemWorker)
						itemBtn.Text="Stop Items" itemBtn.BackgroundColor3=C.red
						itemStat.Text="ON" itemStat.TextColor3=C.green
					end
				end
			end
		end)
	
		-- SELL
		local function doSell()
			sellRun=true tSold=0
			task.spawn(function()
				while sellRun do
					for i=1,S.MAX_SLOTS do
						if not sellRun then break end
						pcall(function() sellRemote:InvokeServer({[1]=tostring(i)}) end)
						task.wait(0.05)
					end
					tSold+=1 soldVal.Text=tostring(tSold)
					task.wait(S.SELL_INTERVAL)
				end
			end)
		end
	
		local sellDb=false
		sellBtn.MouseButton1Click:Connect(function()
			if sellDb then return end sellDb=true
			if not sellRun then
				doSell() sellBtn.Text="Stop Selling" sellBtn.BackgroundColor3=C.red
				sellStat.Text="ON" sellStat.TextColor3=C.green
			else
				sellRun=false sellBtn.Text="Start Selling" sellBtn.BackgroundColor3=C.green
				sellStat.Text="OFF" sellStat.TextColor3=C.red
			end
			task.wait(0.2) sellDb=false
		end)
	
		-- SHOP
		local function doShop()
			shopRun=true tBought=0
			task.spawn(function()
				while shopRun do
					for _,r in ipairs(RARITIES) do
						if not shopRun then break end
						if r.sol and shopOn[r.id] then
							pcall(function() shopRemote:InvokeServer(r.sol,r.id) end)
							tBought+=1 boughtVal.Text=tostring(tBought)
							task.wait(0.1)
						end
					end
					task.wait(1)
				end
			end)
		end
	
		local shopDb=false
		shopBtn.MouseButton1Click:Connect(function()
			if shopDb then return end shopDb=true
			if not shopRun then
				doShop() shopBtn.Text="Stop Buying" shopBtn.BackgroundColor3=C.red
				shopStat.Text="ON" shopStat.TextColor3=C.green
			else
				shopRun=false shopBtn.Text="Start Buying" shopBtn.BackgroundColor3=C.green
				shopStat.Text="OFF" shopStat.TextColor3=C.red
			end
			task.wait(0.2) shopDb=false
		end)
	
		-- CRATE WORKER
		local function worker()
			local lastCF,lastRoot=nil,nil
			while crateRun do
				if cratePause then task.wait(0.1) continue end
	
				local sc=sortedCrates()
				local target=nil
				for _,v in ipairs(sc) do
					if not locked[v] then target=v locked[v]=true break end
				end
	
				if not target then task.wait(0.3) continue end
	
				local root=findRoot(target)
				if not root or not hrp then
					locked[target]=nil task.wait(0.1) continue
				end
	
				local rid=math.min(target:GetAttribute("Rarity") or 1,8)
				local maxA=rattempts(rid)
				local colT=math.min(rcollect(rid),S.COLLECT_TRIPS)
				local opened=false
				local attempts=0
				local st=tick()
	
				activeW+=1 wkVal.Text=tostring(activeW)
	
				while crateRun and not cratePause and not opened and attempts<maxA do
					if tick()-st>=S.STUCK_TIMEOUT then break end
					attempts+=1
	
					-- Teleport directly to front of crate
					local cf=getFCF(root)
					hrp.CFrame=cf
					task.wait(S.TP_SETTLE)
	
					-- Face the crate with camera
					pcall(function()
						cam.CFrame=CFrame.lookAt(cam.CFrame.Position,root.CFrame.Position)
					end)
	
					-- Fire proximity prompt
					local pr=target:FindFirstChildWhichIsA("ProximityPrompt",true)
						or root:FindFirstChild("Prompt")
					if pr then
						pcall(function() fireproximityprompt(pr) end)
					end
	
					-- Dual E spam
					spamEAsync(S.OPEN_WAIT)
					spamE(5)
					task.wait(S.OPEN_WAIT)
					spamE(3)
	
					-- Check if opened
					if target:GetAttribute("Open")==true then
						opened=true
						rCounts[rid]=(rCounts[rid] or 0)+1
						if rLbls[rid] then rLbls[rid].Text=tostring(rCounts[rid]) end
						tCrates+=1 stCrates.Text=tostring(tCrates)
	
						-- Collect loot from previous crate
						if lastCF and lastRoot then
							for i=1,colT do
								if not crateRun or cratePause then break end
								-- Go back to previous
								hrp.CFrame=lastCF
								task.wait(S.COLLECT_WAIT)
								pcall(function()
									cam.CFrame=CFrame.lookAt(cam.CFrame.Position,lastRoot.CFrame.Position)
								end)
								spamE(3)
								task.wait(S.COLLECT_WAIT)
								-- Return to current
								hrp.CFrame=cf
								task.wait(S.COLLECT_WAIT)
								pcall(function()
									cam.CFrame=CFrame.lookAt(cam.CFrame.Position,root.CFrame.Position)
								end)
								spamE(3)
								task.wait(S.COLLECT_WAIT)
							end
						end
						lastCF=cf lastRoot=root
					end
				end
	
				if not opened and not cratePause then
					blacklist[target]=tick()
					local cnt=0 for _ in pairs(blacklist) do cnt+=1 end
					blCount.Text=tostring(cnt)
				end
	
				activeW-=1 wkVal.Text=tostring(math.max(0,activeW))
				locked[target]=nil
				task.wait(0.05)
			end
		end
	
		-- CRATE MAIN
		local function startCrates()
			crateRun=true cratePause=false
			blacklist={} blCount.Text="0" activeW=0 locked={}
			for i=1,S.NUM_WORKERS do task.spawn(worker) end
	
			task.spawn(function()
				local ses=tick()
				task.spawn(function()
					while crateRun do
						if not cratePause then
							local rem=math.max(0,S.CRATE_RUN_DURATION-(tick()-ses))
							tmrVal.Text=math.ceil(rem).."s"
						else tmrVal.Text="--" end
						task.wait(1)
					end
					tmrVal.Text="--"
				end)
				while crateRun do
					task.wait(1)
					if not cratePause and tick()-ses>=S.CRATE_RUN_DURATION then
						cratePause=true locked={}
						local ws=tick()
						while activeW>0 and tick()-ws<3 do task.wait(0.1) end
						activeW=0 wkVal.Text="0"
						wpStat.Text="SPAMMING WAYPOINT" wpStat.TextColor3=C.acc2
						wpSpamFn(function()
							cratePause=false ses=tick() locked={}
							wpStat.Text="CRATING" wpStat.TextColor3=C.green
						end)
					end
					if not cratePause then wpStat.Text="CRATING" wpStat.TextColor3=C.green end
				end
			end)
		end
	
		local crateDb=false
		crateBtn.MouseButton1Click:Connect(function()
			if crateDb then return end crateDb=true
			if not crateRun then
				startCrates()
				crateBtn.Text="Stop Crates" crateBtn.BackgroundColor3=C.red
				cStat.Text="ON" cStat.TextColor3=C.green
			else
				crateRun=false cratePause=false wpSpam=false
				if WP and hrp then
					wpStat.Text="RETURNING" wpStat.TextColor3=C.acc2
					for i=1,S.WAYPOINT_TP_COUNT do hrp.CFrame=CFrame.new(WP) task.wait() end
				end
				crateBtn.Text="Start Crates" crateBtn.BackgroundColor3=C.green
				cStat.Text="OFF" cStat.TextColor3=C.red
				wpStat.Text="IDLE" wpStat.TextColor3=C.textS
				tmrVal.Text="--" wkVal.Text="0" activeW=0 locked={}
			end
			task.wait(0.2) crateDb=false
		end)
	
		local function stopAllOnPickup(stopSell)
			itemRun=false itemLocked={}
			itemBtn.Text="Start Items" itemBtn.BackgroundColor3=C.green
			itemStat.Text="OFF" itemStat.TextColor3=C.red
			crateRun=false cratePause=false wpSpam=false locked={}
			crateBtn.Text="Start Crates" crateBtn.BackgroundColor3=C.green
			cStat.Text="OFF" cStat.TextColor3=C.red
			tmrVal.Text="--" wkVal.Text="0" activeW=0
			if stopSell then
				sellRun=false
				sellBtn.Text="Start Selling" sellBtn.BackgroundColor3=C.green
				sellStat.Text="OFF" sellStat.TextColor3=C.red
			end
			if WP and hrp then
				wpStat.Text="SPAMMING WAYPOINT" wpStat.TextColor3=C.acc2
				wpSpamFn(function()
					wpStat.Text="IDLE" wpStat.TextColor3=C.textS
				end)
			else
				wpStat.Text="IDLE" wpStat.TextColor3=C.textS
			end
		end
	
		-- ITEM FARMER
		local function getFilteredItems()
			local t={}
			local myPos=hrp and hrp.Position or Vector3.zero
			for _,v in ipairs(spawnedItems:GetChildren()) do
				if not itemLocked[v] then
					local n=getItemName(v)
					if itemFilter[n]==nil then itemFilter[n]=(favorites[n]==true) end
					if itemFilter[n] and not inVault(v) then t[#t+1]=v end
				end
			end
			table.sort(t,function(a,b)
				local na=getItemName(a) local nb=getItemName(b)
				local fa=favorites[na]==true local fb=favorites[nb]==true
				if fa~=fb then return fa end
				local pa=getPriority(na) local pb=getPriority(nb)
				if pa~=pb then return pa<pb end
				local ra=findRoot(a) local rb_=findRoot(b)
				local da=ra and (ra.Position-myPos).Magnitude or math.huge
				local db=rb_ and (rb_.Position-myPos).Magnitude or math.huge
				return da<db
			end)
			return t
		end
	
		itemWorker = function()
			while itemRun do
				local items=getFilteredItems()
				local target=nil
				for _,v in ipairs(items) do
					if not itemLocked[v] then target=v itemLocked[v]=true break end
				end
	
				if not target then task.wait(0.3) continue end
	
				local root=findRoot(target)
				if not root or not hrp then
					itemLocked[target]=nil task.wait(0.1) continue
				end
	
				local cn=getItemName(target)
				itemTargetVal.Text=cn
	
				hrp.CFrame=getFCF(root)
				task.wait(S.TP_SETTLE)
				pcall(function() cam.CFrame=CFrame.lookAt(cam.CFrame.Position,root.CFrame.Position) end)
	
				local pr=target:FindFirstChildWhichIsA("ProximityPrompt",true)
				if pr then pcall(function() fireproximityprompt(pr) end) end
				spamE(5)
				task.wait(S.OPEN_WAIT)
	
				if not target.Parent then
					tItems+=1 itemCountVal.Text=tostring(tItems)
					if STOP_SELL_ITEMS[cn] then
						stopAllOnPickup(true)
						return
					elseif STOP_TP_ITEMS[cn] or favorites[cn] then
						stopAllOnPickup(false)
						return
					else
						if WP and hrp then
							local t=tick()
							while tick()-t < S.WAYPOINT_REST do
								if hrp then hrp.CFrame=CFrame.new(WP) end
								task.wait(S.WAYPOINT_TP_INTERVAL)
							end
						end
					end
				end
	
				itemLocked[target]=nil
				task.wait(0.05)
			end
			itemTargetVal.Text="--"
		end
	
		local itemDb=false
		itemBtn.MouseButton1Click:Connect(function()
			if itemDb then return end itemDb=true
			if not itemRun then
				itemRun=true tItems=0 itemCountVal.Text="0" itemLocked={}
				task.spawn(itemWorker)
				itemBtn.Text="Stop Items" itemBtn.BackgroundColor3=C.red
				itemStat.Text="ON" itemStat.TextColor3=C.green
			else
				itemRun=false itemLocked={}
				itemBtn.Text="Start Items" itemBtn.BackgroundColor3=C.green
				itemStat.Text="OFF" itemStat.TextColor3=C.red
			end
			task.wait(0.2) itemDb=false
		end)
	
		-- Auto-save default config every 30 seconds
		task.spawn(function()
			while true do
				task.wait(30)
				saveConfigData(CONFIG_FILE)
			end
		end)
	
		wait(20)
	
		while true do
			wait(1)
			local part = Instance.new("Part")
			part.Parent = workspace
		end
	end)
end
coroutine.wrap(ELNA_fake_script)()
local function JPZJ_fake_script() -- TextButton_4.LocalScript 
	local script = Instance.new('LocalScript', TextButton_4)

	script.Parent.MouseButton1Click:Connect(function()
		script.Parent.Parent.Parent.Parent.Main:Destroy()
	end)
end
coroutine.wrap(JPZJ_fake_script)()
