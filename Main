		-- ============================================================
		local function getSafeParent()
			local ok, _ = pcall(function()
				local test = Instance.new("Frame")
				test.Parent = CoreGui
				test:Destroy()
			end)
			if ok then return CoreGui end
			return LocalPlayer:WaitForChild("PlayerGui", 10) or LocalPlayer.PlayerGui
		end
	
