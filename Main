				local active=(n==name)
				TS:Create(tBtns[n],TweenInfo.new(0.18),{
					BackgroundColor3=active and C.tabOn or C.tabOff,
					TextColor3=active and C.textP or C.textS,
				}):Play()
				if active then
					TS:Create(tabInd,TweenInfo.new(0.18,Enum.EasingStyle.Quad),{
						Position=UDim2.new(0,13+(i-1)*(TAB_W+2),0,99)
					}):Play()
				end
			end
		end
