		end
		local function statBox(par,lbl,order)
			local bx=fr(par,UDim2.new(0,0,0,60),UDim2.new(0,0,0,0),C.stBg,10)
			bx.AutomaticSize=Enum.AutomaticSize.X bx.LayoutOrder=order or 0 sk(bx,C.div,1)
			local p=Instance.new("UIPadding")
			p.PaddingLeft=UDim.new(0,14) p.PaddingRight=UDim.new(0,14)
			p.PaddingTop=UDim.new(0,7) p.PaddingBottom=UDim.new(0,7) p.Parent=bx
			local l=Instance.new("UIListLayout")
			l.SortOrder=Enum.SortOrder.LayoutOrder
			l.HorizontalAlignment=Enum.HorizontalAlignment.Center l.Parent=bx
			local n=lb(bx,"0",UDim2.new(0,72,0,28),UDim2.new(0,0,0,0),C.acc2,true,Enum.TextXAlignment.Center,24)
			n.LayoutOrder=1
			local nm=lb(bx,lbl,UDim2.new(0,72,0,14),UDim2.new(0,0,0,0),C.textD,false,Enum.TextXAlignment.Center,10)
			nm.LayoutOrder=2 return n
		end
	
		-- SLIDER
		local function mkSlider(par,lbl,mn,mx,cur,isF,order,onChange)
			local r=Instance.new("Frame")
			r.Size=UDim2.new(1,0,0,48) r.BackgroundTransparency=1
			r.LayoutOrder=order or 0 r.Parent=par
			lb(r,lbl,UDim2.new(0.62,0,0,19),UDim2.new(0,0,0,0),C.textP,false,Enum.TextXAlignment.Left,12)
			local vl=lb(r,tostring(cur),UDim2.new(0.38,0,0,19),UDim2.new(0.62,0,0,0),C.acc4,true,Enum.TextXAlignment.Right,12)
			local tr=fr(r,UDim2.new(1,0,0,14),UDim2.new(0,0,0,26),C.slBg,7) sk(tr,C.div,1)
			local pct=math.clamp((cur-mn)/(mx-mn),0,1)
			local fi=fr(tr,UDim2.new(pct,0,1,0),UDim2.new(0,0,0,0),C.slFg,7)
			local gg=Instance.new("UIGradient")
			gg.Color=ColorSequence.new({
				ColorSequenceKeypoint.new(0,C.acc3),ColorSequenceKeypoint.new(1,C.acc4),
			}) gg.Parent=fi
			local th=fr(tr,UDim2.new(0,18,0,18),UDim2.new(pct,-9,-0.2,-2),Color3.fromRGB(230,190,255),9)
			sk(th,C.acc2,1.5)
			local overlay=Instance.new("TextButton")
			overlay.Size=UDim2.new(1,0,1,0) overlay.Position=UDim2.new(0,0,0,0)
			overlay.BackgroundTransparency=1 overlay.Text=""
			overlay.BorderSizePixel=0 overlay.ZIndex=10 overlay.Parent=tr
			local drag=false
			local function upd(sx)
				local rel=math.clamp((sx-tr.AbsolutePosition.X)/tr.AbsoluteSize.X,0,1)
				local raw=mn+rel*(mx-mn)
				local val=isF and (math.round(raw*100)/100) or math.round(raw)
				val=math.clamp(val,mn,mx)
				local np=(val-mn)/(mx-mn)
				fi.Size=UDim2.new(np,0,1,0) th.Position=UDim2.new(np,-9,-0.2,-2)
				vl.Text=tostring(val) if onChange then onChange(val) end
			end
			overlay.MouseButton1Down:Connect(function()
				drag=true mf.Draggable=false
				local mp=UIS:GetMouseLocation() upd(mp.X)
			end)
			UIS.InputChanged:Connect(function(input)
				if drag and input.UserInputType==Enum.UserInputType.MouseMovement then
					upd(input.Position.X)
				end
			end)
			UIS.InputEnded:Connect(function(input)
				if input.UserInputType==Enum.UserInputType.MouseButton1 and drag then
					drag=false mf.Draggable=true
				end
			end)
			return r,vl
		end
	
