				cfgListL.SortOrder=Enum.SortOrder.LayoutOrder cfgListL.Padding=UDim.new(0,3) cfgListL.Parent=cfgListSf
				local cfgListPad=Instance.new("UIPadding")
				cfgListPad.PaddingLeft=UDim.new(0,4) cfgListPad.PaddingRight=UDim.new(0,4)
				cfgListPad.PaddingTop=UDim.new(0,4) cfgListPad.PaddingBottom=UDim.new(0,4) cfgListPad.Parent=cfgListSf
				local refreshBtn=bigBtn(cfgListCard,"Refresh List",C.acc1,3)
	
				local function refreshCfgList()
					for _,c in ipairs(cfgListSf:GetChildren()) do
						if c:IsA("TextButton") then c:Destroy() end
					end
					local list=listConfigs()
					if #list==0 then
						local l=lb(cfgListSf,"No configs saved yet",UDim2.new(1,0,0,22),UDim2.new(0,0,0,0),C.textD,false,Enum.TextXAlignment.Center,10)
						l.LayoutOrder=1
					else
						for i,name in ipairs(list) do
							local b=mkBtn(cfgListSf,name,UDim2.new(1,0,0,24),UDim2.new(0,0,0,0),C.btnPurp or C.purple,10)
							b.LayoutOrder=i
							b.MouseButton1Click:Connect(function() cfgNameBox.Text=name end)
						end
					end
				end
	
				refreshBtn.MouseButton1Click:Connect(refreshCfgList)
				refreshCfgList()
	
				local function setCfgStatus(msg,col)
					cfgStatus.Text=msg cfgStatus.TextColor3=col or C.textS
					task.delay(3,function()
						if cfgStatus.Text==msg then cfgStatus.Text="Ready" cfgStatus.TextColor3=C.textS end
					end)
				end
	
				saveBtn.MouseButton1Click:Connect(function()
