			end
			local ifc=card(it,5) secLbl(ifc,"ITEM FILTER",1)
			local ifRefresh=bigBtn(ifc,"Refresh Item List",C.acc1,2)
			local ifSearchRow=row(ifc,3,30)
			searchBox=Instance.new("TextBox")
			searchBox.Size=UDim2.new(1,0,1,0) searchBox.BackgroundColor3=C.slBg
			searchBox.BorderSizePixel=0 searchBox.Text=""
			searchBox.PlaceholderText="Search items..." searchBox.TextColor3=C.textP
			searchBox.PlaceholderColor3=C.textD searchBox.Font=Enum.Font.Gotham
			searchBox.TextSize=11 searchBox.ClearTextOnFocus=false searchBox.Parent=ifSearchRow cr(searchBox,6)
			local ifSfRow=row(ifc,4,180)
			itemFilterSf=Instance.new("ScrollingFrame")
			itemFilterSf.Size=UDim2.new(1,0,1,0)
			itemFilterSf.BackgroundColor3=C.slBg itemFilterSf.BorderSizePixel=0
			itemFilterSf.ScrollBarThickness=3 itemFilterSf.ScrollBarImageColor3=C.acc1
			itemFilterSf.CanvasSize=UDim2.new(0,0,0,0)
			itemFilterSf.AutomaticCanvasSize=Enum.AutomaticSize.Y
			itemFilterSf.Parent=ifSfRow cr(itemFilterSf,6)
			local ifl=Instance.new("UIListLayout")
			ifl.SortOrder=Enum.SortOrder.LayoutOrder ifl.Padding=UDim.new(0,4) ifl.Parent=itemFilterSf
			local ifp=Instance.new("UIPadding")
			ifp.PaddingLeft=UDim.new(0,6) ifp.PaddingRight=UDim.new(0,6)
			ifp.PaddingTop=UDim.new(0,6) ifp.PaddingBottom=UDim.new(0,6) ifp.Parent=itemFilterSf
	
			refreshFavorites = function()
				for _,c in ipairs(favSf:GetChildren()) do
					if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end
				end
				local fnames={}
				for n,on in pairs(favorites) do if on then fnames[#fnames+1]=n end end
				table.sort(fnames)
				for idx,n in ipairs(fnames) do
					local r=row(favSf,idx,26)
					fr(r,UDim2.new(0,3,0,18),UDim2.new(0,0,0,4),C.yellow,2)
					lb(r,"★ "..n,UDim2.new(1,-118,1,0),UDim2.new(0,8,0,0),C.yellow,true,Enum.TextXAlignment.Left,10)
					local nm=n
					if itemFilter[nm]==nil then itemFilter[nm]=true end
					local tb=Instance.new("TextButton")
					tb.Size=UDim2.new(0,54,0,20) tb.Position=UDim2.new(1,-112,0,3)
					tb.BackgroundColor3=itemFilter[nm] and C.green or C.red
					tb.BorderSizePixel=0 tb.Text=itemFilter[nm] and "ON" or "OFF"
					tb.TextColor3=Color3.new(1,1,1) tb.Font=Enum.Font.GothamBold
					tb.TextSize=10 tb.AutoButtonColor=false tb.Parent=r cr(tb,5)
					local rb=Instance.new("TextButton")
					rb.Size=UDim2.new(0,50,0,20) rb.Position=UDim2.new(1,-54,0,3)
					rb.BackgroundColor3=C.acc3 rb.BorderSizePixel=0 rb.Text="Remove"
					rb.TextColor3=Color3.new(1,1,1) rb.Font=Enum.Font.GothamBold
					rb.TextSize=9 rb.AutoButtonColor=false rb.Parent=r cr(rb,5)
					tb.MouseButton1Click:Connect(function()
						itemFilter[nm]=not itemFilter[nm]
						tb.Text=itemFilter[nm] and "ON" or "OFF"
						tb.BackgroundColor3=itemFilter[nm] and C.green or C.red
						if refreshActiveTargets then refreshActiveTargets() end
					end)
					rb.MouseButton1Click:Connect(function()
						favorites[nm]=nil
						refreshFavorites()
						if refreshItemFilter then refreshItemFilter() end
					end)
				end
				if #fnames==0 then
					local l=lb(favSf,"No favorites — click ★ on any item below",UDim2.new(1,0,0,22),UDim2.new(0,0,0,0),C.textD,false,Enum.TextXAlignment.Center,10)
					l.LayoutOrder=1
				end
			end
	
			refreshItemFilter = function()
				for _,c in ipairs(itemFilterSf:GetChildren()) do
					if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end
				end
				local vaultOnly={}
				local seen={}
				for _,v in ipairs(spawnedItems:GetChildren()) do
					local n=getItemName(v)
					local inV=inVault(v)
					if not seen[n] then
						seen[n]=true
						vaultOnly[n]=inV
					else
						if not inV then vaultOnly[n]=false end
					end
				end
				for n,on in pairs(favorites) do if on then seen[n]=true end end
				local query=(searchBox and searchBox.Text or ""):lower()
				local names={}
				for n in pairs(seen) do
					if query=="" or n:lower():find(query,1,true) then
						names[#names+1]=n
					end
				end
				table.sort(names,function(a,b)
					local fa=favorites[a]==true local fb=favorites[b]==true
					if fa~=fb then return fa end
					local va=vaultOnly[a]==true local vb=vaultOnly[b]==true
					if va~=vb then return not va end
					local pa=getPriority(a) local pb=getPriority(b)
					if pa~=pb then return pa<pb end
					return a<b
				end)
				for idx,n in ipairs(names) do
					if itemFilter[n]==nil then itemFilter[n]=(favorites[n]==true) end
					local isFav=favorites[n]==true
					local isPrio=getPriority(n)<math.huge
					local allInVault=vaultOnly[n]==true
					local nameCol=isFav and C.yellow or (allInVault and C.red or (isPrio and C.acc4 or C.textP))
					local r=row(itemFilterSf,idx,28)
					if isFav then
						fr(r,UDim2.new(0,3,0,20),UDim2.new(0,0,0,4),C.yellow,2)
					elseif isPrio then
						fr(r,UDim2.new(0,3,0,20),UDim2.new(0,0,0,4),C.acc2,2)
					end
					local dispName=n..(allInVault and "  (in vault)" or "")
					lb(r,dispName,UDim2.new(1,-112,1,0),UDim2.new(0,(isFav or isPrio) and 8 or 0,0,0,0),nameCol,isFav or isPrio,Enum.TextXAlignment.Left,10)
					local fb2=Instance.new("TextButton")
					fb2.Size=UDim2.new(0,28,0,22) fb2.Position=UDim2.new(1,-108,0,3)
					fb2.BackgroundColor3=isFav and C.yellow or C.slBg fb2.BorderSizePixel=0
					fb2.Text="★" fb2.TextColor3=isFav and Color3.fromRGB(20,15,30) or C.textD
					fb2.Font=Enum.Font.GothamBold fb2.TextSize=13 fb2.AutoButtonColor=false fb2.Parent=r cr(fb2,5)
					local b=Instance.new("TextButton")
					b.Size=UDim2.new(0,68,0,22) b.Position=UDim2.new(1,-68,0,3)
					b.BackgroundColor3=itemFilter[n] and C.green or C.red
					b.BorderSizePixel=0 b.Text=itemFilter[n] and "ON" or "OFF"
					b.TextColor3=Color3.new(1,1,1) b.Font=Enum.Font.GothamBold
					b.TextSize=10 b.AutoButtonColor=false b.Parent=r cr(b,6)
					local nm=n
					fb2.MouseButton1Click:Connect(function()
						if favorites[nm] then favorites[nm]=nil else favorites[nm]=true end
						refreshFavorites()
						refreshItemFilter()
					end)
					b.MouseButton1Click:Connect(function()
						itemFilter[nm]=not itemFilter[nm]
						b.Text=itemFilter[nm] and "ON" or "OFF"
						b.BackgroundColor3=itemFilter[nm] and C.green or C.red
						if refreshActiveTargets then refreshActiveTargets() end
					end)
				end
				if #names==0 then
					local msg=query~="" and ('No items match "'..query..'"') or "No items found — click Refresh"
					local l=lb(itemFilterSf,msg,UDim2.new(1,0,0,22),UDim2.new(0,0,0,0),C.textD,false,Enum.TextXAlignment.Center,10)
					l.LayoutOrder=1
				end
				if refreshActiveTargets then refreshActiveTargets() end
			end
	
			searchBox:GetPropertyChangedSignal("Text"):Connect(function() pcall(refreshItemFilter) end)
			ifRefresh.MouseButton1Click:Connect(refreshItemFilter)
			refreshActiveTargets()
			refreshFavorites()
			refreshItemFilter()
		end
	
		local filterDirty=false
		spawnedItems.ChildAdded:Connect(function() filterDirty=true end)
		spawnedItems.ChildRemoved:Connect(function() filterDirty=true end)
		task.spawn(function()
			while true do
				task.wait(1.5)
				if filterDirty then
					filterDirty=false
					pcall(refreshItemFilter)
				end
			end
		end)
	
